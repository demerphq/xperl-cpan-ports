#!/usr/bin/env perl

use strict;
use warnings;
use feature qw(dispatch_on signatures);
use builtin qw(jumphash_string siphash_2_4);
no warnings 'experimental::builtin';
use Digest::SHA qw(sha256_hex);
use Encode qw(encode);
use File::Basename qw(basename dirname);
use File::Find qw(find);
use File::Path qw(make_path);
use File::Spec;
use FindBin;
use Getopt::Long qw(GetOptions);
use JSON::PP;
use POSIX qw(strftime);

my @caches;
my ($rebuild, $assume_platform);
my $usage = "usage: $0 --cache DIR [...] | --rebuild"
    . " [--assume-platform OS/ARCHNAME]\n";
GetOptions('cache=s@' => \@caches, 'rebuild' => \$rebuild,
           'assume-platform=s' => \$assume_platform)
    or die $usage;
die $usage unless (@caches || $rebuild) && !@ARGV;
my ($assumed_os, $assumed_archname);
if (defined $assume_platform) {
    ($assumed_os, $assumed_archname) =
        $assume_platform =~ m{\A([a-z0-9]+)/([A-Za-z0-9][A-Za-z0-9_.-]*)\z}
        or die "--assume-platform expects OS/ARCHNAME, for example linux/x86_64-linux\n";
}

my $root = File::Spec->catdir($FindBin::Bin, '..');
my $status_dir = File::Spec->catdir($root, 'status');
my $data_dir = File::Spec->catdir($root, 'data');
my $config = JSON::PP->new->decode(read_file(
    File::Spec->catfile($root, 'registry.json')));
die "importer requires the one-repository layout\n"
    unless $config->{schema} == 2
        && $config->{active_repositories} == 1
        && $config->{placement} eq 'siphash24-zero-jump-v1'
        && $config->{fanout} eq 'siphash24-zero-first-byte-v1';
my $json = JSON::PP->new->canonical->pretty;
my %records;

if (-d $data_dir) {
    find({
        no_chdir => 1,
        wanted => sub {
            return unless -f $File::Find::name
                && basename($File::Find::name) eq 'status.json';
            my $path = $File::Find::name;
            my $data = $json->decode(read_file($path));
            my $key = "$data->{author}/$data->{distribution}";
            die "invalid status record: $path\n"
                unless $data->{schema} == 2
                    && ref($data->{observations}) eq 'ARRAY'
                    && $path eq status_path($data->{author},
                                            $data->{distribution})
                    && !exists $records{$key};
            if (defined $assume_platform) {
                # Observations imported before receipts recorded a platform.
                $_->{platform} //= {
                    key => $assume_platform, os => $assumed_os,
                    archname => $assumed_archname,
                } for @{$data->{observations}};
            }
            $records{$key} = $data;
        },
    }, $data_dir);
}

my $imported = 0;
for my $cache (@caches) {
    die "cache directory does not exist: $cache\n" unless -d $cache;
    find({
        no_chdir => 1,
        wanted => sub {
            return unless -f $File::Find::name
                && basename($File::Find::name) eq 'receipt.json';
            my $path = $File::Find::name;
            my $raw = read_file($path);
            my $receipt = eval { $json->decode($raw) };
            die "invalid receipt $path: $@\n" if $@;
            my ($distribution, $release_version) = distribution_name($receipt);
            my $author = author_from_path($receipt->{cpan_path});
            my $key = "$author/$distribution";
            my $entry = $records{$key} //= {
                schema => 2, author => $author, distribution => $distribution,
                observations => [],
            };
            my $id = sha256_hex($raw);
            my ($existing) =
                grep { $_->{id} eq $id } @{$entry->{observations}};
            if ($existing) {
                my $updated =
                    observation($receipt, $path, $id, $release_version);
                $updated->{observed_at} = $existing->{observed_at};
                %$existing = %$updated;
                return;
            }
            push @{$entry->{observations}},
                observation($receipt, $path, $id, $release_version);
            ++$imported;
        },
    }, $cache);
}

my @current;
for my $key (sort keys %records) {
    my $entry = $records{$key};
    my ($author, $distribution) = @{$entry}{qw(author distribution)};
    @{$entry->{observations}} = sort {
        $a->{observed_at} cmp $b->{observed_at}
            || $a->{id} cmp $b->{id}
    } @{$entry->{observations}};
    write_file(status_path($author, $distribution), $json->encode($entry));
    my %latest;
    for my $observation (@{$entry->{observations}}) {
        my $key = join "\0", @{$observation}{qw(version source_sha256 xperl_version)},
            platform_key($observation);
        $latest{$key} = $observation;
    }
    push @current, map {
        { author => $author, distribution => $distribution,
          observation => $_ }
    } values %latest;
}

@current = sort {
    $a->{author} cmp $b->{author}
        || $a->{distribution} cmp $b->{distribution}
        || $a->{observation}{version} cmp $b->{observation}{version}
        || platform_key($a->{observation}) cmp platform_key($b->{observation})
} @current;
my @unresolved = grep { $_->{observation}{status} eq 'failed' } @current;
my $summary = "# XPerl CPAN build status\n\n";
$summary .= "Latest observation for each author, distribution release, source hash, XPerl version, and platform.\n";
$summary .= "Older failures remain in the distribution records.\n\n";
$summary .= "Unresolved failures: " . scalar(@unresolved) . " of " . scalar(@current)
    . " release, XPerl, and platform combinations. See [UNRESOLVED.md](UNRESOLVED.md).\n\n";
$summary .= "| Author | Distribution | Version | XPerl | Platform | Status | Patch set |\n";
$summary .= "| --- | --- | --- | --- | --- | --- | --- |\n";
for my $row (@current) {
    my ($author, $distribution, $observation) =
        @{$row}{qw(author distribution observation)};
    $summary .= join(' | ',
        "| $author", "[$distribution](" . status_link($author, $distribution) . ")",
        $observation->{version}, $observation->{xperl_version},
        platform_key($observation), $observation->{status},
        $observation->{patch_set} // 'none') . " |\n";
}
write_file(File::Spec->catfile($status_dir, 'SUMMARY.md'), $summary);

my $unresolved = "# Unresolved XPerl CPAN builds\n\n";
$unresolved .= "Latest failed observation for each author, release, source hash, XPerl version, and platform.\n";
$unresolved .= "Prior failures remain in each distribution record after a later success.\n\n";
$unresolved .= "| Author | Distribution | Version | XPerl | Platform | Failed phase | Result |\n";
$unresolved .= "| --- | --- | --- | --- | --- | --- | --- |\n";
for my $row (@unresolved) {
    my ($author, $distribution, $observation) =
        @{$row}{qw(author distribution observation)};
    my $failure = $observation->{failure} // {};
    $unresolved .= join(' | ',
        "| $author", "[$distribution](" . status_link($author, $distribution) . ")",
        $observation->{version}, $observation->{xperl_version},
        platform_key($observation),
        $failure->{phase} // 'unknown',
        $observation->{test_summary} // ("exit " . ($failure->{exit_status} // '?')))
        . " |\n";
}
write_file(File::Spec->catfile($status_dir, 'UNRESOLVED.md'), $unresolved);
print "Imported $imported observations; " . scalar(@unresolved)
    . " unresolved of " . scalar(@current) . " release, XPerl, and platform combinations\n";

sub read_file ($path) {
    open my $file, '<', $path or die "cannot read $path: $!\n";
    local $/;
    my $data = <$file>;
    close $file or die "cannot close $path: $!\n";
    return $data;
}

sub write_file ($path, $data) {
    make_path(dirname($path));
    open my $file, '>', $path or die "cannot write $path: $!\n";
    print {$file} $data;
    close $file or die "cannot close $path: $!\n";
}

sub author_from_path ($path) {
    my ($initial, $pair, $author) =
        ($path // '') =~ m{\A([A-Z])/([A-Z]{2})/([A-Z0-9_-]+)/(?:[^/]+/)*[^/]+\z};
    die "invalid CPAN author path: " . ($path // '') . "\n"
        unless defined($author) && substr($author, 0, 1) eq $initial
            && substr($author, 0, 2) eq $pair;
    return $author;
}

sub status_path ($author, $distribution) {
    die "invalid distribution name: $distribution\n"
        unless defined($distribution)
            && $distribution =~ /\A[A-Za-z0-9][A-Za-z0-9_.-]*\z/;
    die "invalid CPAN author: $author\n"
        unless defined($author) && $author =~ /\A[A-Z0-9_-]+\z/;
    my $key = encode('UTF-8', "$author/$distribution");
    my $prefix = unpack 'H2', siphash_2_4($key, "\0" x 16);
    return File::Spec->catfile($data_dir, $prefix, $author,
                               $distribution, 'status.json');
}

sub status_link ($author, $distribution) {
    my $key = encode('UTF-8', "$author/$distribution");
    my $prefix = unpack 'H2', siphash_2_4($key, "\0" x 16);
    return "../data/$prefix/$author/$distribution/status.json";
}

sub distribution_name ($receipt) {
    my $archive = basename($receipt->{cpan_path} // die "receipt lacks CPAN path\n");
    $archive =~ s/\.(?:tar\.gz|tar\.bz2|tar\.xz|tgz|zip)\z//
        or die "unsupported CPAN archive: $archive\n";
    my ($distribution, $release_version) =
        $archive =~ /\A(.+)-([vV]?\d[0-9A-Za-z._-]*)\z/
            or die "cannot parse distribution release: $archive\n";
    die "unsafe distribution name: $distribution\n"
        unless $distribution =~ /\A[A-Za-z0-9][A-Za-z0-9._-]*\z/;
    return ($distribution, $release_version);
}

sub observation ($receipt, $path, $id, $release_version) {
    my $status = $receipt->{status} // die "receipt lacks status: $path\n";
    dispatch ($status) {
        on ('installed') { }
        on ('failed') { }
        on (_) { die "unknown receipt status $status: $path\n" }
    }
    my @phases = map {
        {
            name => $_->{name},
            (defined($_->{attempt}) ? (attempt => $_->{attempt}) : ()),
            exit_status => $_->{exit_status},
            (defined($_->{validation_error})
                ? (validation_error => $_->{validation_error}) : ()),
        }
    } @{$receipt->{phases} // []};
    my ($failed) = reverse grep {
        $_->{exit_status} || $_->{validation_error}
    } @phases;
    my ($test) = reverse grep { $_->{name} eq 'test' } @{$receipt->{phases} // []};
    my $test_summary;
    if ($test && defined($test->{log}) && -f $test->{log}) {
        my $log = read_file($test->{log});
        my ($files, $tests) = $log =~ /^Files=(\d+), Tests=(\d+)/m;
        $test_summary = "Files=$files, Tests=$tests"
            if defined $files;
        my ($failed_tests) =
            $log =~ /^(Failed \d+\/\d+ test programs\.[^\n]*)/m;
        $test_summary .= ", $failed_tests"
            if $test_summary && $failed_tests;
    }
    my $registered = ($receipt->{registration}{status} // '') eq 'registered'
        ? $receipt->{registration} : undef;
    return {
        id => $id,
        observed_at => strftime('%Y-%m-%dT%H:%M:%SZ',
                                gmtime((stat($path))[9])),
        module => $receipt->{module},
        version => $release_version,
        (defined($receipt->{version}) && $receipt->{version} ne $release_version
            ? (module_version => $receipt->{version}) : ()),
        cpan_path => $receipt->{cpan_path},
        source_sha256 => $receipt->{source_sha256},
        xperl_version => $receipt->{xperl_version},
        (ref($receipt->{platform}) eq 'HASH'
            ? (platform => platform($receipt->{platform})) : ()),
        status => $status,
        patch_set => $registered ? $registered->{patch_set}
            : $receipt->{registry}{patch_set},
        ($registered ? (patch_purpose => 'compatibility')
            : defined($receipt->{registry}{purpose})
            ? (patch_purpose => $receipt->{registry}{purpose}) : ()),
        ($receipt->{registry}{advisories}
            ? (advisories => $receipt->{registry}{advisories}) : ()),
        patch_sha256 => $registered ? [$registered->{patch_sha256}]
            : $receipt->{registry}{patches} // [],
        phases => \@phases,
        ($test_summary ? (test_summary => $test_summary) : ()),
        ($failed ? (failure => {
            phase => $failed->{name},
            exit_status => $failed->{exit_status},
            (defined($failed->{validation_error})
                ? (validation_error => $failed->{validation_error}) : ()),
        }) : ()),
    };
}

# Observations from receipts written before the installer recorded the
# platform have no platform block; they keep a distinct "unrecorded" key.
sub platform_key ($observation) {
    my $platform = $observation->{platform};
    return ref($platform) eq 'HASH' && length($platform->{key} // '')
        ? $platform->{key} : 'unrecorded';
}

# The portable platform description from a receipt: no local paths.
sub platform ($platform) {
    die "receipt platform lacks a key\n"
        unless length($platform->{key} // '');
    return { map { $_ => $platform->{$_} } grep { defined $platform->{$_} }
             qw(key os osvers archname cc cc_version make usethreads
                use64bitall xperl_commit) };
}
