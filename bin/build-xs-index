#!/usr/bin/env perl

use v5.36;
use strict;
use warnings;

use File::Basename qw(basename dirname);
use File::Find qw(find);
use File::Spec;
use FindBin;
use JSON::PP;

my $check = @ARGV && $ARGV[0] eq '--check' ? shift @ARGV : 0;
die "usage: $0 [--check]\n" if @ARGV;

my $root = File::Spec->catdir($FindBin::Bin, '..');
my $data_dir = File::Spec->catdir($root, 'data');
my $json = JSON::PP->new->canonical->pretty;
my @entries;

find({
    no_chdir => 1,
    wanted => sub {
        return unless -f $File::Find::name
            && basename($File::Find::name) eq 'index.json';

        my $index_path = $File::Find::name;
        my $directory = dirname($index_path);
        my $index = $json->decode(read_file($index_path));
        my ($author, $distribution) = ($directory =~ m{/([^/]+)/([^/]+)\z});
        my $relative_dir = $directory =~ s{\A\Q$data_dir\E/}{data/}r;

        for my $release (@{$index->{releases}}) {
            for my $set (@{$release->{patch_sets}}) {
                my (@native_files, @patch_paths, @patch_digests);

                for my $patch (@{$set->{patches}}) {
                    my $path = "$relative_dir/$patch->{path}";
                    my $source = read_file("$directory/$patch->{path}");
                    push @patch_paths, $path;
                    push @patch_digests, $patch->{sha256};

                    # The target file headers identify native code changes.
                    while ($source =~ /^\+\+\+ (?:b\/)?([^\t\r\n]+)(?:\t[^\r\n]*)?$/mg) {
                        my $file = $1;
                        push @native_files, $file
                            if $file =~ /\.(?:xs|c|h|inc|cc|cpp)\z/i;
                    }
                }
                next unless @native_files;

                my %seen;
                @native_files = sort(grep { !$seen{$_}++ } @native_files);
                my @evidence_paths = evidence_for(
                    $directory, $relative_dir, $release, $set, \@patch_digests,
                );

                push @entries, {
                    author => $author,
                    distribution => $distribution,
                    version => $release->{version},
                    patch_set => $set->{id},
                    index_path => "$relative_dir/index.json",
                    patch_paths => \@patch_paths,
                    native_files => \@native_files,
                    recipes => $set->{recipes} // [],
                    evidence_paths => \@evidence_paths,
                };
            }
        }
    },
}, $data_dir);

@entries = sort {
    $a->{distribution} cmp $b->{distribution}
        || $a->{author} cmp $b->{author}
        || $a->{version} cmp $b->{version}
        || $a->{patch_set} cmp $b->{patch_set}
} @entries;

my $catalog = $json->encode({ schema => 1, entries => \@entries });
my $markdown = "# XS and C compatibility patches\n\n";
$markdown .= "Generated by `bin/build-xs-index` from registered patch file headers. "
    . "A row means a patch changes native source, not that every change in "
    . "the patch is XPerl-specific. Evidence links match the exact source "
    . "and patch digests.\n\n";
$markdown .= "| Distribution | Author | Version | Patch set | Native files | Evidence |\n";
$markdown .= "| --- | --- | --- | --- | --- | --- |\n";

for my $entry (@entries) {
    my $patches = join ', ', map {
        my $name = basename($_);
        "[$name](../$_)"
    } @{$entry->{patch_paths}};
    my $evidence = @{$entry->{evidence_paths}}
        ? join ', ', map {
            my $name = basename($_);
            "[$name](../$_)"
        } @{$entry->{evidence_paths}}
        : '—';
    $markdown .= join(' | ',
        "| [$entry->{distribution}](../$entry->{index_path})",
        $entry->{author}, $entry->{version},
        "$entry->{patch_set}: $patches",
        join(', ', @{$entry->{native_files}}), $evidence,
    ) . " |\n";
}

my %outputs = (
    'XS-PATCHES.json' => $catalog,
    'XS-PATCHES.md' => $markdown,
);
for my $name (sort keys %outputs) {
    my $path = File::Spec->catfile($root, 'status', $name);
    if ($check) {
        die "$path is missing or stale; run bin/build-xs-index\n"
            unless -f $path && read_file($path) eq $outputs{$name};
        next;
    }
    open my $output, '>:raw', $path or die "$path: $!\n";
    print {$output} $outputs{$name} or die "$path: $!\n";
    close $output or die "$path: $!\n";
}

print scalar(@entries), " native patch sets indexed\n";

sub evidence_for ($directory, $relative_dir, $release, $set, $digests) {
    my $evidence_dir = "$directory/evidence";
    return () unless -d $evidence_dir;

    opendir my $dir, $evidence_dir or die "$evidence_dir: $!\n";
    my @names = sort grep { /\.json\z/ && -f "$evidence_dir/$_" } readdir $dir;
    closedir $dir;

    my @matches;
    for my $name (@names) {
        my $record = $json->decode(read_file("$evidence_dir/$name"));
        next unless ($record->{source_sha256} // '') eq $release->{source_sha256}
            && ($record->{patch_set_id} // '') eq $set->{id};
        my @record_digests = ref($record->{patch_sha256}) eq 'ARRAY'
            ? @{$record->{patch_sha256}}
            : ($record->{patch_sha256} // ());
        next unless join("\0", @record_digests) eq join("\0", @$digests);
        push @matches, "$relative_dir/evidence/$name";
    }
    return @matches;
}

sub read_file ($path) {
    open my $input, '<:raw', $path or die "$path: $!\n";
    local $/;
    return <$input>;
}
