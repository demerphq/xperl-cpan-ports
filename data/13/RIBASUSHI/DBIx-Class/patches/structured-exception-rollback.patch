+          && $run_err->{msg} =~ /Rollback failed:/
+      )) {
         # some DBDs go crazy if there is nothing to roll back on, perform a soft-check
         my $rollback_exception = $storage->_seems_connected
           ? (! eval { $storage->txn_rollback; 1 }) ? $@ : ''
