--- a/lib/DBIx/Class/Exception.pm
+++ b/lib/DBIx/Class/Exception.pm
@@ -51,6 +51,17 @@
 sub throw {
     my ($class, $msg, $stacktrace) = @_;
 
+    if (${^XPERL_VERSION} && ref($msg)
+        && UNIVERSAL::isa($msg, 'XPerl::Exception')) {
+        require XPerl::DiagGroup;
+        my $diagnostics = $msg->diagnostics;
+        if (@$diagnostics == 1 && $diagnostics->[0]->code eq 'ERROR_USER_TEXT') {
+            my ($text) = grep { $_->{name} eq 'text' }
+                @{$diagnostics->[0]->params};
+            $msg = $text->{value} if $text;
+        }
+    }
+
     # Don't re-encapsulate exception objects of any kind
     die $msg if ref($msg);
 
