--- a/include/file_compat.h
+++ b/include/file_compat.h
@@ -48,6 +48,17 @@
 #  define XS_INTERNAL(name) static XSPROTO(name)
 #endif
 
+/* Custom ops bypass the XSUB wrapper. Give their legacy stack operations
+ * an uncounted stack segment on RC builds. The prototype keeps the wrapper
+ * private, since XSPP_wrapped itself starts with a static declaration. */
+#if defined(PERL_RC_STACK) && (defined(XPERL_VERSION) || defined(XSPP_wrapped))
+#  define FILE_RAW_PP(name, nargs) \
+      static OP *name(pTHX); \
+      XSPP_wrapped(name, nargs, 0)
+#else
+#  define FILE_RAW_PP(name, nargs) static OP *name(pTHX)
+#endif
+
 /* Op sibling macros - introduced in 5.22, needed for call checkers */
 #ifndef OpHAS_SIBLING
 #  define OpHAS_SIBLING(o)      ((o)->op_sibling != NULL)
--- a/t/014-file-map-grep.t
+++ b/t/014-file-map-grep.t
@@ -118,4 +118,26 @@
     is_deeply($results[0], [1, 1, 1], 'nested for with File::Raw::exists works');
 };
 
+subtest 'custom op ownership with temporary arguments' => sub {
+    my (@contents, @sizes, @lines, @names, @writes, @warnings);
+    {
+        local $SIG{__WARN__} = sub { push @warnings, @_ };
+        for my $i (1..20) {
+            push @writes, File::Raw::spew("$tempdir/retained$i.txt", "iteration $i\n");
+            push @contents, File::Raw::slurp("$tempdir/retained$i.txt");
+            push @sizes, File::Raw::size("$tempdir/retained$i.txt");
+            push @lines, File::Raw::lines("$tempdir/retained$i.txt");
+            push @names, File::Raw::basename("$tempdir/retained$i.txt");
+            File::Raw::exists("$tempdir/retained$i.txt");
+            File::Raw::append("$tempdir/retained$i.txt", "tail\n");
+        }
+    }
+    is_deeply(\@writes, [map { 1 } 1..20], 'two-argument results survive cleanup');
+    is_deeply(\@contents, [map { "iteration $_\n" } 1..20], 'strings survive cleanup');
+    is_deeply(\@sizes, [map { length("iteration $_\n") } 1..20], 'integers survive cleanup');
+    is_deeply(\@lines, [map { ["iteration $_"] } 1..20], 'references survive cleanup');
+    is_deeply(\@names, [map { "retained$_.txt" } 1..20], 'path results survive cleanup');
+    is_deeply(\@warnings, [], 'custom ops do not warn about scalar ownership');
+};
+
 done_testing();
