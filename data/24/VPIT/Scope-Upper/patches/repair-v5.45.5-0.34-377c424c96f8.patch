+#!perl -T
+
+use strict;
+use warnings;
+
+use Test::More tests => 19;
+use Scope::Upper qw<unwind yield leave uplevel HERE CALLER>;
+
+{
+ package Scope::Upper::Lifetime;
+ our $destroyed = 0;
+ sub new { bless { label => 'alive' }, shift }
+ sub DESTROY { ++$destroyed }
+}
+
+my @warnings;
+local $SIG{__WARN__} = sub { push @warnings, @_ };
+
+my @returns = (
+ [ unwind => sub {
+   my $value = Scope::Upper::Lifetime->new;
+   sub { unwind $_[0] => CALLER(1) }->($value);
+   die 'unwind did not leave the target';
+ } ],
+ [ yield => sub {
+   my $value = Scope::Upper::Lifetime->new;
+   sub { yield $_[0] => CALLER(1) }->($value);
+   die 'yield did not leave the target';
+ } ],
+ [ leave => sub {
+   my $value = Scope::Upper::Lifetime->new;
+   leave $value;
+   die 'leave did not leave the target';
+ } ],
+);
+
+for my $case (@returns) {
+ my ($name, $code) = @$case;
+ $Scope::Upper::Lifetime::destroyed = 0;
+ my @values = $code->();
+ is scalar(@values), 1, "$name returns one value";
+ isa_ok $values[0], 'Scope::Upper::Lifetime';
+ is $values[0]->{label}, 'alive', "$name preserves the object";
+ is $Scope::Upper::Lifetime::destroyed, 0, "$name keeps the result alive";
+ @values = ();
+ is $Scope::Upper::Lifetime::destroyed, 1, "$name releases the result once";
+}
+
+$Scope::Upper::Lifetime::destroyed = 0;
+sub {
+ uplevel { } HERE;
+ is $Scope::Upper::Lifetime::destroyed, 0, 'uplevel preserves caller arguments';
+ is $_[0]->{label}, 'alive', 'caller argument is usable after uplevel';
+}->(Scope::Upper::Lifetime->new);
+is $Scope::Upper::Lifetime::destroyed, 1, 'caller argument is released once';
+is_deeply \@warnings, [], 'return and argument cleanup emit no warnings';
