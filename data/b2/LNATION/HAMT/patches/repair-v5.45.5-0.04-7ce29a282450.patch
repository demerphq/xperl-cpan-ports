+# A thrown object with loop-like text is not loop control.
+{
+    my $renders = 0;
+    {
+        package Local::LoopError;
+        use overload '""' => sub { $renders++; 'Can\'t "last" outside a loop block' },
+                     'bool' => sub { 1 }, fallback => 1;
+    }
+    my $error = bless {}, 'Local::LoopError';
+    eval { $m->each(sub { die $error }) };
+    is(refaddr($@), refaddr($error), 'a loop-like error object passes through unchanged');
+    is($renders, 0, 'the error object is not stringified to identify loop control');
+}
+
+SKIP: {
+    skip 'XPerl structured exceptions are not available', 8
+        unless XPerl::Exception->can('has_diagnostic');
+    no warnings 'exiting';
+    for my $render (qw(en:annotated en:legacy:JSON en:legacy:Dumper)) {
+        local ${^DIAG_RENDER} = $render;
+        my $calls = 0;
+        $v->each(sub { last if ++$calls == 2 });
+        is($calls, 2, "last stops a walk with $render rendering");
+        my @seen;
+        $v->each(sub { next if $_[0] % 2; push @seen, $_[0] });
+        is_deeply(\@seen, [grep { !($_ % 2) } 1 .. 50],
+                  "next skips with $render rendering");
+    }
+    my $text = "Can't \"last\" outside a loop block\n";
+    eval { $m->each(sub { die $text }) };
+    is("$@", $text, 'user text resembling loop control is not a loop diagnostic');
+    eval { $m->each(sub { redo }) };
+    my $error = $@;
+    eval { $m->each(sub { die $error }) };
+    is(refaddr($@), refaddr($error), 'an unrelated structured exception retains its identity');
+}
