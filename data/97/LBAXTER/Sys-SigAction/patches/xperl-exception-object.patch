--- a/lib/Sys/SigAction.pm
+++ b/lib/Sys/SigAction.pm
@@ -166,7 +166,9 @@
       sig_alarm(0);
       die $@ if $@;
    };
-   die $@ if $@ and (not ref $@ or $@ != TIMEDOUT);
+   # an XPerl::Exception wraps a plain-text die; it is never TIMEDOUT
