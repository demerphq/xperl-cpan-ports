--- /dev/null
+++ b/t/45-stack.t
@@ -0,0 +1,80 @@
+#!perl -T
+
+use strict;
+use warnings;
+
+use Test::More;
+
+my @cases = (
+ [ 'hash slice',
+   'my $x; my @v = @$x{qw(a b)}; [\@v, $x]',
+   [ [ undef, undef ], undef ] ],
+ [ 'array slice',
+   'my $x; my @v = @$x[0, 1]; [\@v, $x]',
+   [ [ undef, undef ], undef ] ],
+ [ 'hash keys',
+   'my $x; [scalar(keys %{$x->{a}}), $x]', [ 0, undef ] ],
+ [ 'array keys',
+   'my $x; [scalar(keys @{$x->[0]}), $x]', [ 0, undef ], 5.011 ],
+ [ 'array values',
+   'my $x; [scalar(values @{$x->[0]}), $x]', [ 0, undef ], 5.011 ],
+ [ 'temporary hash exists',
+   'exists +{a => {b => 42}}->{a}{b}', 1 ],
+ [ 'temporary array exists',
+   'exists [ [42] ]->[0][0]', 1 ],
+ [ 'temporary hash delete',
+   'delete +{a => [42]}->{a}[0]', 42 ],
+ [ 'temporary array delete',
+   'delete [ {a => 42} ]->[0]{a}', 42 ],
+ [ 'missing nested element',
+   'my $x; [(exists $x->{a}[0]), (delete $x->{a}[0]), $x]',
+   [ '', undef, undef ] ],
+);
+
+plan tests => 2 * @cases + 6;
+
+for my $case (@cases) {
+ my ($name, $code, $expected, $min_perl) = @$case;
+ SKIP: {
+  skip "perl $min_perl required", 2 if $min_perl && "$]" < $min_perl;
+  my ($result, $error);
+  for (1 .. 20) {
+   local $SIG{__WARN__} = sub { die @_ };
+   $result = eval "no autovivification;\n$code";
+   $error = $@;
+   last if $error;
+  }
+  is $error, '', "$name: no ownership warnings";
+  is_deeply $result, $expected, "$name: result";
+ }
+}
+
+{
+ package autovivification::StackObject;
+ our $destroyed = 0;
+ sub DESTROY { ++$destroyed }
+}
+
+sub temporary_object {
+ return {a => {b => bless {}, 'autovivification::StackObject'}};
+}
+
+my $held = eval {
+ local $SIG{__WARN__} = sub { die @_ };
+ no autovivification;
+ delete temporary_object()->{a}{b};
+};
+is $@, '', 'delete from a temporary container: no warnings';
+isa_ok $held, 'autovivification::StackObject';
+is $autovivification::StackObject::destroyed, 0, 'deleted value stays alive';
+undef $held;
+is $autovivification::StackObject::destroyed, 1, 'deleted value is released';
+
+eval {
+ local $SIG{__WARN__} = sub { die @_ };
+ no autovivification;
+ delete temporary_object()->{a}{b};
+ 1;
+};
+is $@, '', 'void delete from a temporary container: no warnings';
+is $autovivification::StackObject::destroyed, 2, 'void delete releases the value';
