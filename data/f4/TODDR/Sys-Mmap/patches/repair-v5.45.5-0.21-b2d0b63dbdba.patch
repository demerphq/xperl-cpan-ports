     munmap($foo);
 }
 
+# Exercise both argument counts at one call site with a live offset scalar.
+{
+    my $offset = 3;
+    sysopen(my $fh, $temp_file, O_RDONLY) or die "$temp_file: $!\n";
+    for my $case (
+        [ 'explicit offset', [ $offset ], $offset ],
+        [ 'omitted offset', [], 0 ],
+        [ 'undefined offset', [ undef ], 0 ],
+        [ 'zero offset', [ 0 ], 0 ],
+        [ 'string offset', [ "$offset" ], $offset ],
+        [ 'omitted offset again', [], 0 ],
+    ) {
+        my ($label, $args, $expected_offset) = @$case;
+        my $data;
+        &Sys::Mmap::mmap($data, 16, PROT_READ, MAP_SHARED, $fh, @$args);
+        is($data, substr($temp_file_contents, $expected_offset, 16), $label);
+        munmap($data);
+    }
+    close $fh;
+
+    eval { &Sys::Mmap::mmap(my $data, 16, PROT_READ, MAP_SHARED) };
+    like($@, qr/^Usage:/, 'filehandle argument is required');
+}
+
 
 unlink($temp_file);
