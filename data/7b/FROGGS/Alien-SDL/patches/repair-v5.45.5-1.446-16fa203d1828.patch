@@ -0,0 +1,92 @@
+use strict;
+use warnings;
+
+use Test::More tests => 20;
+use Capture::Tiny qw(capture);
+use Digest::SHA qw(sha1_hex);
+use File::Spec::Functions qw(catfile);
+use File::Temp qw(tempdir);
+use lib 'inc';
+use My::Builder;
+
+my $builder = bless {}, 'My::Builder';
+my $download = tempdir(CLEANUP => 1);
+my $file = catfile($download, 'archive.tar.gz');
+my @urls = map { "http://example.invalid/$_/archive.tar.gz" } qw(first second third);
+my $good = "expected archive\n";
+my $bad = "changed archive\n";
+my $digest = sha1_hex($good);
+my (@tried, %payload);
+
+sub write_file {
+  my ($path, $content) = @_;
+  open my $fh, '>', $path or die "open $path: $!";
+  binmode $fh;
+  print {$fh} $content or die "write $path: $!";
+  close $fh or die "close $path: $!";
+}
+
+sub fetch {
+  my ($urls) = @_;
+  @tried = ();
+  my ($result, $error);
+  my ($out, $err) = capture {
+    $result = eval { $builder->fetch_file($urls, $digest, $download) };
+    $error = $@;
+  };
+  return ($result, $error);
+}
+
+{
+  no warnings 'redefine';
+  local *File::Fetch::fetch = sub {
+    my ($ff, %args) = @_;
+    my $url = $ff->uri;
+    push @tried, $url;
+    return unless defined $payload{$url};
+    my $path = catfile($args{to}, $ff->file);
+    write_file($path, $payload{$url});
+    return $path;
+  };
+
+  write_file($file, $good);
+  my ($ok, $error) = fetch(\@urls);
+  ok($ok, 'valid cached archive is accepted');
+  is($error, '', 'valid cache does not raise an error');
+  is_deeply(\@tried, [], 'valid cache avoids all transfers');
+
+  write_file($file, $bad);
+  %payload = ($urls[0] => $bad, $urls[1] => $good, $urls[2] => $bad);
+  ($ok, $error) = fetch(\@urls);
+  ok($ok, 'valid mirror replaces corrupt cache and corrupt first download');
+  is($error, '', 'checksum mismatch does not prevent mirror fallback');
+  is_deeply(\@tried, [@urls[0, 1]], 'stops after the first verified mirror');
+  ok($builder->check_sha1sum($file, $digest), 'cached replacement matches pinned digest');
+
+  unlink $file or die "unlink $file: $!";
+  %payload = ($urls[1] => $bad, $urls[2] => $good);
+  ($ok, $error) = fetch(\@urls);
+  ok($ok, 'transport failure and checksum failure both allow fallback');
+  is($error, '', 'mixed failures do not reject a later valid mirror');
+  is_deeply(\@tried, \@urls, 'tries all mirrors when needed');
+
+  unlink $file or die "unlink $file: $!";
+  %payload = map { $_ => $bad } @urls;
+  ($ok, $error) = fetch(\@urls);
+  ok(!$ok, 'all corrupt mirrors fail');
+  like($error, qr/Checksum failed/, 'reports checksum failure after exhausting mirrors');
+  is_deeply(\@tried, \@urls, 'checks every corrupt mirror');
+  ok(!-e $file, 'rejected download is removed from cache');
+
+  %payload = ();
+  ($ok, $error) = fetch(\@urls);
+  ok(!$ok, 'all unavailable mirrors fail');
+  like($error, qr/Unable to fetch/, 'reports transport failure');
+  is_deeply(\@tried, \@urls, 'tries every unavailable mirror');
+
+  %payload = map { $_ => $good } @urls;
+  ($ok, $error) = fetch(\@urls);
+  ok($ok, 'valid first download succeeds');
+  is($error, '', 'valid first download has no error');
+  is_deeply(\@tried, [$urls[0]], 'valid first download avoids later mirrors');
+}
