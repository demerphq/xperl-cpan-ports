+use strict;
+use warnings;
+
+use Test::More tests => 12;
+use Capture::Tiny qw(capture);
+use File::Path qw(make_path);
+use File::Spec::Functions qw(catdir catfile);
+use File::Temp qw(tempdir);
+use lib 'inc';
+use My::Utility qw(check_prereqs_libs);
+
+my $work = tempdir(CLEANUP => 1);
+my $include = catdir($work, 'include');
+my $preferred = catdir($work, 'lib64');
+my $multiarch = catdir($work, 'lib', 'test-multiarch');
+make_path($include, $preferred, $multiarch);
+
+sub write_file {
+  my ($file) = @_;
+  open my $fh, '>', $file or die "open $file: $!";
+  print {$fh} "test fixture\n";
+  close $fh or die "close $file: $!";
+}
+
+sub detect {
+  my ($name) = @_;
+  my $result;
+  capture { $result = check_prereqs_libs($name) };
+  return $result;
+}
+
+my %config = (%My::Utility::Config, libpth => "$multiarch $preferred $multiarch");
+local *My::Utility::Config = \%config;
+local *My::Utility::get_dlext = sub { 'so' };
+local $My::Utility::inc_lib_candidates = {$include => $preferred};
+write_file(catfile($include, 'pthread.h'));
+write_file(catfile($multiarch, 'libpthread.a'));
+my $shared = catfile($multiarch, 'libpthread.so.0');
+write_file($shared);
+
+my $found = detect('pthread');
+ok($found->[0], 'finds pthread in a configured multiarch directory');
+is($found->[1], $shared, 'returns the configured shared library path');
+
+my $local_shared = catfile($preferred, 'libpthread.so');
+write_file(catfile($preferred, 'libpthread.a'));
+write_file($local_shared);
+$found = detect('pthread');
+ok($found->[0], 'finds pthread in the original preferred directory');
+is($found->[1], $local_shared, 'preferred directory takes precedence over Config');
+unlink catfile($preferred, 'libpthread.a') or die "unlink preferred libpthread.a: $!";
+unlink $local_shared or die "unlink preferred shared library: $!";
+
+$My::Utility::inc_lib_candidates->{$include} = catdir($work, 'absent');
+$found = detect('pthread');
+ok($found->[0], 'fallback works when the preferred directory does not exist');
+is($found->[1], $shared, 'fallback returns the configured shared library');
+
+unlink catfile($include, 'pthread.h') or die "unlink pthread.h: $!";
+ok(!detect('pthread')->[0], 'a library without its header is rejected');
+write_file(catfile($include, 'pthread.h'));
+unlink catfile($multiarch, 'libpthread.a') or die "unlink libpthread.a: $!";
+ok(detect('pthread')->[0], 'a versioned shared library with its header is sufficient');
+unlink $shared or die "unlink $shared: $!";
+ok(!detect('pthread')->[0], 'a header without its library is rejected');
+write_file(catfile($multiarch, 'libpthread.a'));
+$found = detect('pthread');
+ok($found->[0], 'a static link library with its header is sufficient');
+ok(!defined $found->[1], 'a static library is not reported as a runtime library');
+ok(!detect('missing')->[0], 'a missing library is rejected');
