+use strict;
+use warnings;
+
+use Test::More tests => 12;
+use Capture::Tiny qw(capture);
+use Cwd qw(abs_path getcwd);
+use File::Copy qw(copy);
+use File::Path qw(make_path);
+use File::Spec::Functions qw(catdir catfile);
+use File::Temp qw(tempdir);
+use Module::Build;
+
+my $source = abs_path('.');
+my $work = tempdir(CLEANUP => 1);
+make_path(catdir($work, 'lib', 'Alien'));
+copy('Build.PL', catfile($work, 'Build.PL')) or die "copy Build.PL: $!";
+copy(catfile('lib', 'Alien', 'SDL.pm'), catfile($work, 'lib', 'Alien', 'SDL.pm'))
+  or die "copy SDL.pm: $!";
+
+my $config = catfile($work, 'sdl-config.pl');
+open my $fh, '>', $config or die "open $config: $!";
+print {$fh} <<'CONFIG';
+use strict;
+use warnings;
+if ($ARGV[0] eq '--version') { print "1.2.15\n" }
+elsif ($ARGV[0] eq '--prefix') { print ".\n" }
+else { die "Unexpected sdl-config argument: @ARGV\n" }
+CONFIG
+close $fh or die "close $config: $!";
+
+my $script = qq{"$^X" "$config"};
+my @paths = map { catfile($work, $_) } qw(arch bin bindoc lib libdoc script);
+my @install_options;
+my @types = qw(arch bin bindoc lib libdoc script);
+for my $i (0 .. $#types) {
+  push @install_options, '--install_path', "$types[$i]=$paths[$i]";
+}
+
+my $cwd = getcwd();
+chdir $work or die "chdir $work: $!";
+my ($out, $err, $status) = capture {
+  system($^X, '-I' . catdir($source, 'inc'), 'Build.PL',
+    '--installdirs', 'site', @install_options,
+    '--with-sdl-config=' . $script, '--travis');
+};
+is($status, 0, 'Build.PL accepts custom and standard build options together');
+unlike($out . $err, qr/Unknown option|Too early to specify a build action/,
+  'option parsing produces no rejected options or spurious build action');
+ok(-f 'Build', 'configuration creates the build script');
+diag($out . $err) if $status;
+
+SKIP: {
+  skip 'configuration failed', 9 if $status || !-f 'Build';
+  local @INC = (catdir($source, 'inc'), @INC);
+  local @ARGV = ();
+  my $build = Module::Build->resume;
+  is($build->installdirs, 'site', 'installdirs value is preserved');
+  for my $i (0 .. $#types) {
+    is($build->install_path($types[$i]), $paths[$i],
+      "install_path for $types[$i] is preserved");
+  }
+  is($build->notes('build_params')->{script}, $script,
+    'explicit sdl-config command is preserved');
+  is(${$build->get_options->{travis}->{store}}, 1, 'travis flag is preserved');
+}
+chdir $cwd or die "chdir $cwd: $!";
