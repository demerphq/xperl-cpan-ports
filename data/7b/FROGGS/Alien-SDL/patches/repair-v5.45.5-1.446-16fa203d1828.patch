+use strict;
+use warnings;
+
+use Test::More;
+use Capture::Tiny qw(capture);
+use Cwd qw(getcwd);
+use File::Path qw(make_path);
+use File::Spec::Functions qw(catdir catfile);
+use File::Temp qw(tempdir);
+use lib 'inc';
+use My::Builder;
+
+my $work = tempdir(CLEANUP => 1);
+my $cwd = getcwd();
+chdir $work or die "chdir $work: $!";
+
+sub write_file {
+  my ($file, $text) = @_;
+  open my $fh, '>', $file or die "open $file: $!";
+  print {$fh} $text or die "write $file: $!";
+  close $fh or die "close $file: $!";
+}
+
+sub configure {
+  my ($builder, $error);
+  my $dir = getcwd();
+  my ($out, $err) = capture {
+    $builder = eval { My::Builder->new(
+      module_name => 'Alien::SDL', dist_version => '1.446',
+      dist_abstract => 'Manifest regression fixture', license => 'perl',
+    ) };
+    $error = $@;
+  };
+  chdir $dir or die "chdir $dir: $!";
+  return ($builder, $error, $out . $err);
+}
+
+write_file('MANIFEST', "MANIFEST\nsource.txt\nempty.txt\n");
+write_file('source.txt', "source fixture\n");
+write_file('empty.txt', '');
+my ($builder, $error, $log) = configure();
+ok($builder, 'a complete kit configures') or diag $error . $log;
+unlike($log, qr/files are missing/, 'an empty source file counts as present');
+
+unlink 'source.txt' or die "unlink source.txt: $!";
+($builder, $error, $log) = configure();
+ok($builder, 'a missing source file remains a warning');
+like($log, qr/files are missing.*source\.txt/s, 'missing source file is reported');
+write_file('source.txt', "source fixture\n");
+unlink 'MANIFEST' or die "unlink MANIFEST: $!";
+($builder, $error, $log) = configure();
+ok($builder, 'configuration without MANIFEST succeeds');
+unlike($log, qr/files are missing/, 'absent MANIFEST does not warn about source files');
+write_file('MANIFEST', "MANIFEST\nsource.txt\nempty.txt\n");
+
+SKIP: {
+  my $lib = catdir('sharedir', 'fixture', 'lib');
+  make_path($lib);
+  my $middle = catfile($lib, 'libSDL_ttf.so.0');
+  my $alias = catfile($lib, 'libSDL_ttf.so');
+  my $target = catfile($lib, 'libSDL_ttf.so.0.10.1');
+  skip 'symbolic links are unavailable', 7
+    unless eval { symlink('libSDL_ttf.so.0.10.1', $middle) };
+  symlink('libSDL_ttf.so.0', $alias) or die "symlink $alias: $!";
+  write_file($target, "library fixture\n");
+  ($builder, $error, $log) = configure();
+  ok($builder, 'configuration accepts a generated library symlink chain')
+    or diag $error . $log;
+  is($error, '', 'generated links do not cause a traversal exception');
+
+  unlink $target or die "unlink $target: $!";
+  ($builder, $error, $log) = configure();
+  ok($builder, 'configuration accepts a stale generated library symlink chain')
+    or diag $error . $log;
+  is($error, '', 'dangling generated links do not cause a traversal exception');
+  unlike($log, qr/files are missing/, 'unlisted build artifacts are not source requirements');
+
+  write_file('MANIFEST', "MANIFEST\nsource.txt\nempty.txt\nmissing.txt\n");
+  ($builder, $error, $log) = configure();
+  ok($builder, 'stale generated links do not prevent the missing-file check');
+  like($log, qr/files are missing.*missing\.txt/s, 'missing source is reported with stale links present');
+}
+
+chdir $cwd or die "chdir $cwd: $!";
+done_testing;
