+use strict;
+use warnings;
+
+use Test::More;
+use Capture::Tiny qw(capture);
+use Cwd qw(abs_path getcwd);
+use File::Path qw(make_path);
+use File::Spec::Functions qw(catdir catfile);
+use File::Temp qw(tempdir);
+use lib 'inc';
+use My::Builder;
+use My::Utility qw($source_packs);
+
+plan skip_all => 'Unix source-build regression' if $^O eq 'MSWin32';
+my $source = abs_path('.');
+my $download = catdir($source, 'download');
+my $archive = catfile($download, 'SDL_ttf-2.0.11.tar.gz');
+plan skip_all => 'SDL_ttf source archive is not cached' unless -f $archive;
+
+my ($pack) = grep { $_->{pack} eq 'SDL_ttf' }
+  map { @{$_->{members}} } @$source_packs;
+my $builder = bless {}, 'My::Builder';
+plan skip_all => 'SDL_ttf source archive does not match the pinned digest'
+  unless $builder->check_sha1sum($archive, $pack->{sha1sum});
+plan tests => 21;
+
+my $work = tempdir(CLEANUP => 1);
+my $bin = catdir($work, 'bin');
+my $native = catdir($work, 'src');
+make_path($bin, $native);
+
+sub write_file {
+  my ($file, $text) = @_;
+  open my $fh, '>', $file or die "open $file: $!";
+  print {$fh} $text or die "write $file: $!";
+  close $fh or die "close $file: $!";
+}
+
+{
+  no warnings qw(redefine once);
+  local *My::Builder::notes = sub { {members => [$pack]} };
+  local *My::Builder::base_dir = sub { $source };
+  capture { $builder->extract_sources($download, catdir($source, 'patches'), $native) };
+}
+my $src = catdir($native, $pack->{dirname});
+my @fragment;
+for my $file ('configure.in', 'configure') {
+  open my $fh, '<', catfile($src, $file) or die "open $file: $!";
+  local $/;
+  my $text = <$fh>;
+  ($fragment[@fragment]) = $text =~ /(no_freetype="".*?)(?=SDL_VERSION|dnl Check for SDL)/s;
+}
+# Regenerating configure from configure.in must preserve the fallback.
+my $fallback = qr/(if test "\$FREETYPE_CONFIG" = "no" ; then\n    # FreeType.*?\nfi)/s;
+my ($input) = $fragment[0] =~ $fallback;
+my ($output) = $fragment[1] =~ $fallback;
+ok(defined $input && defined $output && $input eq $output,
+  'configure input and shipped script contain the same fallback');
+
+my $pkg = <<'SH';
+#!/bin/sh
+case "$*" in
+  '--exists freetype2') test "$PKG_AVAILABLE" = 1 ;;
+  'freetype2 --cflags') echo "-DFREETYPE_FROM_${PKG_MARKER}" ;;
+  'freetype2 --libs') echo "-lfreetype_${PKG_MARKER}" ;;
+  --atleast-pkgconfig-version*) exit 0 ;;
+  *) exit 1 ;;
+esac
+SH
+for my $name ('pkg-config', 'target-pkg-config') {
+  my $path = catfile($bin, $name);
+  write_file($path, $pkg);
+  chmod 0755, $path or die "chmod $path: $!";
+}
+my $legacy = catfile($bin, 'selected-freetype-config');
+write_file($legacy, <<'SH');
+#!/bin/sh
+case "$1" in
+  --cflags) echo -DFREETYPE_FROM_LEGACY ;;
+  --libs) echo -lfreetype_LEGACY ;;
+  *) exit 1 ;;
+esac
+SH
+my $sdl = catfile($bin, 'sdl-config');
+write_file($sdl, <<'SH');
+#!/bin/sh
+case "$1" in
+  --version) echo 1.2.15 ;;
+  --cflags) echo -DSDL_FIXTURE ;;
+  --libs) echo -lSDL_fixture ;;
+  *) exit 1 ;;
+esac
+SH
+chmod 0755, $legacy, $sdl or die "chmod fixtures: $!";
+
+sub configure {
+  my ($name, $env) = @_;
+  my $build = catdir($work, $name);
+  make_path($build);
+  local %ENV = (%ENV, PATH => "$bin:$ENV{PATH}", SDL_CONFIG => $sdl,
+    PKG_AVAILABLE => 1, PKG_MARKER => 'PKG');
+  delete @ENV{qw(FREETYPE_CONFIG PKG_CONFIG ac_cv_path_FREETYPE_CONFIG)};
+  @ENV{keys %$env} = values %$env;
+  my $cwd = getcwd();
+  chdir $build or die "chdir $build: $!";
+  my ($out, $err, $status) = capture {
+    system('sh', catfile($src, 'configure'), '--disable-sdltest');
+  };
+  my $makefile = '';
+  if (open my $fh, '<', 'Makefile') { local $/; $makefile = <$fh> }
+  chdir $cwd or die "chdir $cwd: $!";
+  return ($status, $out . $err, $makefile);
+}
+
+for my $case (
+  ['default-pkg', {ac_cv_path_FREETYPE_CONFIG => 'no'}, 'PKG'],
+  ['override-pkg', {ac_cv_path_FREETYPE_CONFIG => 'no',
+    PKG_CONFIG => catfile($bin, 'target-pkg-config'), PKG_MARKER => 'TARGET'}, 'TARGET'],
+  ['legacy', {ac_cv_path_FREETYPE_CONFIG => $legacy, PKG_AVAILABLE => 0}, 'LEGACY'],
+  ['explicit', {FREETYPE_CONFIG => $legacy, PKG_AVAILABLE => 0}, 'LEGACY'],
+) {
+  my ($name, $env, $marker) = @$case;
+  my ($status, $log, $makefile) = configure($name, $env);
+  is($status, 0, "$name configures successfully") or diag $log;
+  like($makefile, qr/^CFLAGS = .*\Q-DFREETYPE_FROM_$marker\E/m, "$name uses selected include flags");
+  like($makefile, qr/^LIBS = .*\Q-lfreetype_$marker\E/m, "$name uses selected link flags");
+  unlike($log, qr/Unable to find FreeType2/, "$name passes FreeType detection");
+}
+for my $case (
+  ['no-metadata', {ac_cv_path_FREETYPE_CONFIG => 'no', PKG_AVAILABLE => 0}],
+  ['no-tool', {ac_cv_path_FREETYPE_CONFIG => 'no', PKG_CONFIG => catfile($bin, 'absent')}],
+) {
+  my ($name, $env) = @$case;
+  my ($status, $log) = configure($name, $env);
+  ok($status != 0, "$name rejects missing FreeType configuration");
+  like($log, qr/Unable to find FreeType2/, "$name reports the missing dependency");
+}
