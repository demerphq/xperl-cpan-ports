@@ -2,6 +2,7 @@
 use FFI::Platypus;
 use FFI::Platypus::Record::Meta;
 use Data::Dumper qw( Dumper );
+use Capture::Tiny qw( capture );
 
 my $ffi = FFI::Platypus->new;
 $ffi->lib(undef);
@@ -42,4 +43,25 @@
 
 };
 
+subtest 'custom callbacks during global destruction' => sub {
+
+  local $ENV{PERL_DESTRUCT_LEVEL} = 2;
+  my($stdout, $stderr, $status) = capture {
+    system $^X, '-Mblib', '-e', q{
+      use FFI::Platypus::Record;
+      for my $i (1..32)
+      {
+        eval "package RecordCleanup$i; use FFI::Platypus::Record; "
+           . "record_layout(uint8 => 'value'); 1" or die $@;
+      }
+      print "created records\n";
+    };
+    $?;
+  };
+
+  is $stdout, "created records\n", 'records created before destruction';
+  is $status, 0, 'record metadata destructors exit successfully';
+  is $stderr, '', 'global destruction has no diagnostics';
+};
+
 done_testing;
