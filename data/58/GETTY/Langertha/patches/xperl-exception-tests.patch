--- /dev/null
+++ b/t/lib/Test/ExceptionText.pm
@@ -0,0 +1,19 @@
+package Test::ExceptionText;
+
+use strict;
+use warnings;
+use Exporter 'import';
+
+our @EXPORT_OK = qw( exception_text );
+
+# XPerl records source locations as an exception crosses async boundaries.
+# Keep the original message, including a caller-supplied trailing newline.
+sub exception_text {
+  my ($error) = @_;
+  return undef unless defined $error;
+  $error = "$error";
+  $error =~ s/(?: at \S+ line \d+\.?\n?|\t\.\.\.propagated(?: at \S+ line \d+\.?\n?)?)+\z//;
+  return $error;
+}
+
+1;
