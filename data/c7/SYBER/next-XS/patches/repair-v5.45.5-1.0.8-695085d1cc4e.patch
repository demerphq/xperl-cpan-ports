-done_testing();
\ No newline at end of file
+{
+    package RepeatBase;
+    sub method { shift; return wantarray ? @_ : $_[0] }
+    sub direct { goto &method }
+    sub maybe { goto &method }
+    sub maybe_direct { goto &method }
+    sub can_method { goto &method }
+    sub can_direct { goto &method }
+
+    package RepeatChild;
+    our @ISA = ('RepeatBase');
+    sub method { shift->next::method(@_) }
+    sub direct { next::method(@_) }
+    sub maybe { shift->maybe::next::method(@_) }
+    sub maybe_direct { maybe::next::method(@_) }
+    sub can_method { my $self = shift; $self->next::can->($self, @_) }
+    sub can_direct { my $self = shift; next::can($self)->($self, @_) }
+    sub missing { shift->maybe::next::method(@_) }
+    sub missing_direct { maybe::next::method(@_) }
+    sub missing_can { shift->next::can }
+}
+
+subtest 'repeated dispatch preserves methods and stack values' => sub {
+    my $object = bless {}, 'RepeatChild';
+    for my $pass (1..10) {
+        for my $method (qw(method direct maybe maybe_direct can_method can_direct)) {
+            is($object->$method(42), 42, "$method scalar pass $pass");
+            is_deeply([$object->$method(42, 43)], [42, 43],
+                      "$method list pass $pass");
+            $object->$method(42);
+        }
+        for my $method (qw(missing missing_direct)) {
+            is(scalar $object->$method, undef, "$method scalar pass $pass");
+            is_deeply([$object->$method], [], "$method list pass $pass");
+            $object->$method;
+        }
+        is($object->missing_can, undef, "missing next::can pass $pass");
+    }
+};
+
+done_testing();
