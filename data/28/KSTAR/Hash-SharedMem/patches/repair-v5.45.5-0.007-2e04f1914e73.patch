--- a/t/op.t
+++ b/t/op.t
@@ -2,7 +2,7 @@
 use strict;
 
 use File::Temp 0.22 qw(tempdir);
-use Test::More tests => 388;
+use Test::More tests => 392;
 
 BEGIN { use_ok "Hash::SharedMem", qw(
 	is_shash check_shash
@@ -510,4 +510,42 @@
 eval { ${\shash_snapshot($sn)} = undef; };
 like $@, qr/\AModification of a read-only value attempted /;
 
+my(@retained, @stack_warnings);
+{
+	local $SIG{__WARN__} = sub { push @stack_warnings, @_ };
+	for my $i (1..20) {
+		my $handle = shash_open("$tmpdir/stack", "rwc");
+		shash_set($handle, "key", "old".$i);
+		shash_cset($handle, "key", "old".$i, "new".$i);
+		push @retained, shash_get(shash_snapshot($handle), "key");
+		check_shash($handle);
+	}
+}
+is_deeply \@retained, [map { "new".$_ } 1..20],
+	"custom op results survive temporary handles and later statements";
+is_deeply \@stack_warnings, [], "custom ops balance stack references";
+
+SKIP: {
+	skip "weak references unavailable", 2
+		unless eval { require Scalar::Util; Scalar::Util->can("weaken") };
+	my $weak;
+	{
+		my $handle = shash_open("$tmpdir/lifetime", "rwc");
+		$weak = $handle;
+		Scalar::Util::weaken($weak);
+		is_shash($handle);
+		shash_set($handle, "key", "value");
+		shash_get($handle, "key");
+		shash_cset($handle, "key", "value", undef);
+	}
+	ok !defined($weak), "custom ops release consumed handle references";
+	{
+		my $handle = shash_open("$tmpdir/lifetime", "r");
+		$weak = $handle;
+		Scalar::Util::weaken($weak);
+		eval { shash_set($handle, "key", "value") };
+	}
+	ok !defined($weak), "custom op exceptions release handle references";
+}
+
 1;
