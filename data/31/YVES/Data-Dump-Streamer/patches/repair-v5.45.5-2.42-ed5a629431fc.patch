@@ -0,0 +1,43 @@
+use strict;
+use warnings;
+use Test::More;
+use Data::Dump::Streamer qw(weak_refcount sv_refcount refcount weaken);
+
+plan skip_all => "No Weak Refs" unless eval { my $x = \my $y; weaken($x); 1 };
+
+# The backref magic's mg_obj is the backref holder itself (an AV of weak
+# referrers, or the single weak RV), and hashes keep it in HvAUX rather
+# than in magic.  Misreading it gives wrong counts and can segfault.
+{
+    my $sv = "Foo";
+    my $r1 = \$sv;
+    weaken($r1);
+    is weak_refcount($sv), 1, "one weak ref to scalar";
+    my @r = map { \$sv } 1 .. 3;
+    weaken($_) for @r;
+    is weak_refcount($sv), 4, "four weak refs to scalar";
+    is sv_refcount($sv), 5, "sv_refcount includes weak refs";
+}
+{
+    my @a;
+    my $ar = \@a;
+    weaken($ar);
+    is refcount(\@a), 3, "refcount of weakly referenced array";
+}
+{
+    my %h;
+    my $hr = \%h;
+    weaken($hr);
+    is refcount(\%h), 3, "refcount of weakly referenced hash";
+}
+{
+    my $bad = 0;
+    for my $i (1 .. 5000) {
+        my $sv = "Foo$i";
+        my @r = map { \$sv } 1 .. 1 + $i % 3;
+        weaken($_) for @r;
+        $bad++ if weak_refcount($sv) != @r;
+    }
+    is $bad, 0, "weak_refcount stable under repetition";
+}
+done_testing;
