--- a/t/20-method-name-collision.t
+++ b/t/20-method-name-collision.t
@@ -1,6 +1,6 @@
 use strict;
 use warnings;
-use Test::More tests => 8;
+use Test::More tests => 12;
 
 use Colouring::In::XS;
 
@@ -28,3 +28,19 @@
 # Sanity: real Colouring object still dispatches through our pp
 my $c = Colouring::In::XS->new('#fff');
 is($c->toHEX, '#fff', 'colouring ->toHEX still works');
+
+{
+    package ForeignXS;
+    no warnings 'once';
+    *toHEX = \&Colouring::In::XS::get_message;
+}
+is(ForeignXS->toHEX, undef, 'a foreign XS method falls through');
+
+{
+    package ForeignDies;
+    sub toHEX { die "foreign method exception\n" }
+}
+my $ok = eval { ForeignDies->toHEX; 1 };
+ok(!$ok, 'a foreign Perl method can throw');
+like($@, qr/^foreign method exception/, 'the foreign exception survives');
+is($c->toHEX, '#fff', 'colouring calls work after foreign fallback');
--- a/t/22-methods.t
+++ b/t/22-methods.t
@@ -52,4 +52,32 @@
 is($h->toRGB, 'rgba(255,255,255,0.5)', 'toRGB keeps an alpha below one');
 is($c->toRGB, 'rgb(51,102,153)', 'and drops an alpha of one');
 
+{
+    package Colouring::In::XS::Tracked;
+    our @ISA = ('Colouring::In::XS');
+    our $destroyed = 0;
+    sub DESTROY { $destroyed++ }
+}
+
+my @stack_warnings;
+{
+    local $SIG{__WARN__} = sub { push @stack_warnings, @_ };
+    my (@hex, @channels);
+    for (1 .. 20) {
+        push @hex, Colouring::In::XS::Tracked->new('#123')->toHEX(1);
+        @channels = Colouring::In::XS->new('#123')->colour;
+        Colouring::In::XS->new('#123')->toRGB;
+    }
+    is_deeply(\@hex, [('#112233') x 20], 'temporary invocants return strings');
+    is_deeply(\@channels, [17, 34, 51], 'list results survive temporary invocants');
+    is($Colouring::In::XS::Tracked::destroyed, 20,
+       'optimized calls release temporary invocants');
+
+    my $ok = eval { $c->mix('invalid colour'); 1 };
+    ok(!$ok, 'an optimized method can throw');
+    like($@, qr/Cannot convert the colour format/, 'the exception survives');
+    is($c->toHEX(1), '#336699', 'the stack works after an exception');
+}
+is_deeply(\@stack_warnings, [], 'optimized calls preserve stack ownership');
+
 done_testing;
