+/* Wrap the whole marked argument list, including the resolved method CV.
+ * The invocant guard runs before wrapping: entersub must see the original
+ * stack when it dispatches a foreign Perl or XS method. */
+#if defined(XPERL_VERSION) && defined(PERL_RC_STACK)
+#  define COLOURING_PP_BODY(name) XSPP_wrapped(name, 0, 1)
+#else
+#  define COLOURING_PP_BODY(name) static OP * name(pTHX)
+#endif
+
+#define COLOURING_PP(name)                         \
+    static OP * name##_body(pTHX);                 \
+    static OP * name(pTHX) {                       \
+        COLOURING_GUARD_INVOCANT();                \
+        return name##_body(aTHX);                  \
+    }                                             \
+    COLOURING_PP_BODY(name##_body)
+
 /* ── Format ops (self → string) ───────────────────────────────── */
 
