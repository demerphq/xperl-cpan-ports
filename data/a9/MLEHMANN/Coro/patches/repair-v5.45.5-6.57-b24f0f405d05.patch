+++ b/t/21_stack.t
@@ -0,0 +1,80 @@
+use strict;
+use warnings;
+use Test::More tests => 17;
+use Scalar::Util qw(weaken);
+use Coro;
+
+my @warnings;
+local $SIG{__WARN__} = sub { push @warnings, @_ };
+
+my @values = ("before", cede, "after");
+is_deeply \@values, ["before", "after"], 'cede preserves surrounding list values';
+is scalar cede, undef, 'cede supplies undef in scalar context';
+
+sub wait_args { &Coro::rouse_wait }
+for my $iteration (1 .. 3) {
+   my $cb = Coro::rouse_cb;
+   $cb->("first", "last");
+   is wait_args($cb), "last", 'ampersand SLF call returns the last scalar';
+}
+
+for my $iteration (1 .. 3) {
+   my $cb = Coro::rouse_cb;
+   my $task = async { cede; $cb->({ iteration => $iteration }, 77) };
+   my @result = Coro::rouse_wait($cb);
+   is_deeply \@result, [{ iteration => $iteration }, 77], 'rouse values survive a switch';
+   $task->join;
+}
+
+{
+   my $weak;
+   my $task = async {
+      my $value = { payload => "alive" };
+      $weak = $value;
+      weaken $weak;
+      cede;
+      $value;
+   };
+   my $result = $task->join;
+   is $result->{payload}, "alive", 'join keeps a returned reference alive';
+   undef $task;
+   cede;
+   ok defined $weak, 'result survives destruction of the coroutine';
+   undef $result;
+   cede;
+   ok !defined $weak, 'returned reference is released';
+}
+
+my $done = 0;
+for (1 .. 3) {
+   Coro::async_pool { cede; ++$done };
+   cede until $done == $_;
+}
+is $done, 3, 'pooled coroutines resume and can be reused';
+
+{
+   my $weak;
+   my $task = async {
+      my $value = { payload => "cancel" };
+      $weak = $value;
+      weaken $weak;
+      Coro::rouse_wait(Coro::rouse_cb());
+   };
+   cede;
+   ok defined $weak, 'suspended coroutine owns its lexical';
+   $task->cancel;
+   undef $task;
+   cede;
+   ok !defined $weak, 'cancellation releases the suspended lexical';
+}
+
+{
+   my @trace;
+   my $task = async { my $value = { payload => "trace" }; cede; $value };
+   $task->{_trace_line_cb} = sub { push @trace, [@_] };
+   $task->trace(Coro::State::CC_TRACE() | Coro::State::CC_TRACE_LINE());
+   is $task->join->{payload}, "trace", 'tracing preserves coroutine results';
+   ok @trace, 'trace callbacks ran';
+}
+
+is_deeply \@warnings, [], 'no scalar reference-count warnings';
