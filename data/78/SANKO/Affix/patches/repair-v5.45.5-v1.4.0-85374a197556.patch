+/* The list borrows native payloads, without keeping their CVs alive.
+   Normal CV cleanup unlinks its payload in constant time. */
+static void _affix_track(pTHX_ Affix * affix, MAGIC * mg) {
+    dMY_CXT;
+    affix->cv_magic = mg;
+    affix->next_live = MY_CXT.live_affixes;
+    if (affix->next_live)
+        affix->next_live->previous_live = affix;
+    MY_CXT.live_affixes = affix;
+#ifdef MULTIPLICITY
+    affix->owner_perl = aTHX;
+#endif
+}
+
 static void _affix_destroy(pTHX_ Affix * affix) {
     if (!affix)
         return;
 
     dMY_CXT;
+    if (affix->cv_magic) {
+        if (affix->previous_live)
+            affix->previous_live->next_live = affix->next_live;
+        else
+            MY_CXT.live_affixes = affix->next_live;
+        if (affix->next_live)
+            affix->next_live->previous_live = affix->previous_live;
+
+        /* The CV can survive until the final SV sweep. Its magic must
+           not free this payload again after interpreter-exit cleanup. */
+        affix->cv_magic->mg_ptr = nullptr;
+        affix->cv_magic = nullptr;
+    }
     if (affix->lib_handle != nullptr && MY_CXT.lib_registry != nullptr) {
         hv_iterinit(MY_CXT.lib_registry);
         HE * he;
@@ -2323,6 +2350,16 @@
     safefree(affix);
 }
 
+/* Perl's final SV sweep can free a payload's cache and return scalar
+   before its CV. Release surviving payloads while those SVs are valid,
+   after user destructors but before that sweep. */
+static void _affix_cleanup_live(pTHX_ void * unused) {
+    dMY_CXT;
+    PERL_UNUSED_ARG(unused);
+    while (MY_CXT.live_affixes)
+        _affix_destroy(aTHX_ MY_CXT.live_affixes);
+}
