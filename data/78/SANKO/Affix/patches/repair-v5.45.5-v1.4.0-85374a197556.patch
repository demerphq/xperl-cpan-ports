+subtest 'read and call a callback member from Perl' => sub {
+    my $st = Struct [ fn => Callback [ [Int32] => Int32 ], data => Int32 ];
+    my $mem = Affix::malloc( sizeof($st) );
+    my $pin = cast( $mem, $st );
+    $pin->{fn} = sub ($x) { $x + 1 };
+
+    # Reading the member invokes get-magic outside an Affix XSUB.
+    my @values;
+    for my $x ( 1 .. 20 ) {
+        my $callback = $pin->{fn};
+        push @values, $callback->($x);
+    }
+    is \@values, [ 2 .. 21 ], 'repeated reads preserve callback arguments and results';
+    my @args = ( 'before', $pin->{fn}, 'after' );
+    is $args[0], 'before', 'get-magic preserves preceding stack arguments';
+    is $args[2], 'after', 'get-magic preserves following stack arguments';
+    is $args[1]->(41), 42, 'callback survives the temporary wrapping scope';
+};
