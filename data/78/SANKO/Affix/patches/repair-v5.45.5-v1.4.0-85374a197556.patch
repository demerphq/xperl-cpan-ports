--- /dev/null
+++ b/t/092_shutdown.t
@@ -0,0 +1,32 @@
+use v5.40;
+use strict;
+use warnings;
+
+use Test2::V0;
+use File::Temp qw(tempfile);
+use IPC::Open3 qw(open3);
+
+# The marshaller test leaves callable struct members alive at shutdown.
+# A child process makes an abort after its TAP plan a failing assertion here.
+# Fixed seeds exercise different allocation and global-destruction orders.
+for my $seed (0, 1, 15, 31) {
+    local $ENV{PERL_DESTRUCT_LEVEL} = 2;
+    local $ENV{PERL_HASH_SEED} = $seed;
+    local $ENV{PERL_PERTURB_KEYS} = 2;
+
+    my ($log, $path) = tempfile(UNLINK => 1);
+    my $output = '>&' . fileno($log);
+    my $pid = open3(my $input, $output, $output,
+                    $^X, '-Mblib', 't/999_marshaller_2.t');
+    close $input;
+    waitpid($pid, 0);
+    my $status = $?;
+
+    is $status, 0, "marshaller exits cleanly with hash seed $seed";
+    if ($status) {
+        seek $log, 0, 0 or die "seek $path: $!";
+        diag do { local $/; <$log> };
+    }
+}
+
+done_testing;
