 The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/),
 and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).
 
+## [Unreleased]
+
+### Fixed
+
+- Reading a callback member from Perl on XPerl with `PERL_RC_STACK` no longer
+  frees the wrapper's arguments and result prematurely. The call from get-magic
+  uses a separate non-reference-counted stack for its legacy stack operations.
+
 ## [v1.4.0] - 2026-10-31
 
 ### Fixed
--- a/lib/Affix/marshal.c
+++ b/lib/Affix/marshal.c
@@ -808,6 +808,11 @@
         sig_ptr++;
 
     dSP;
+#if defined(XPERL_VERSION) && defined(PERL_RC_STACK)
+    /* Get-magic can enter with an RC stack. Give the legacy stack
+       operations below a separate non-RC stack, as magic_methcall does. */
+    PUSHSTACKi(PERLSI_MAGIC);
+#endif
     ENTER;
     SAVETMPS;
     PUSHMARK(SP);
@@ -835,6 +840,9 @@
     PUTBACK;
     FREETMPS;
     LEAVE;
+#if defined(XPERL_VERSION) && defined(PERL_RC_STACK)
+    POPSTACK;
+#endif
 
     return ret;
 }
