--- /dev/null
+++ b/t/22local.t
@@ -0,0 +1,104 @@
+#!perl
+use strict;
+use warnings;
+use Test::More tests => 33;
+use File::Temp qw(tempfile);
+use Cwd qw(abs_path);
+use WWW::Curl::Easy;
+use WWW::Curl::Multi;
+use WWW::Curl::Form;
+use WWW::Curl::Share;
+
+for my $name (qw(CURL_DEPRECATED CURL_IGNORE_DEPRECATION
+        CURL_HAS_DECLSPEC_ATTRIBUTE CURL_STRICTER CURLOPT CURLOPTDEPRECATED)) {
+    local $!;
+    WWW::Curl::Easy::constant($name);
+    ok($!, "$name is not exported as an integer constant");
+}
+
+my ($file, $path) = tempfile(UNLINK => 1);
+binmode $file;
+my $payload = "local curl transfer\0\xff\n" x 100;
+print $file $payload;
+close $file or die "Cannot close test input: $!";
+my $url = 'file://' . abs_path($path);
+
+my $curl = WWW::Curl::Easy->new;
+isa_ok($curl, 'WWW::Curl::Easy');
+is($curl->setopt(CURLOPT_URL, $url), 0, 'set local file URL');
+my $body = '';
+is($curl->setopt(CURLOPT_WRITEDATA, \$body), 0, 'set scalar output');
+my ($cookie_file, $cookie_path) = tempfile(UNLINK => 1);
+my $cookie = join("\t", qw(example.test FALSE / FALSE 0 www_curl_test fixture));
+print $cookie_file "# Netscape HTTP Cookie File\n$cookie\n"
+    or die "Cannot write test cookie: $!";
+close $cookie_file or die "Cannot close test cookie: $!";
+is($curl->setopt(CURLOPT_COOKIEFILE, $cookie_path), 0, 'set local cookie file');
+is($curl->perform, 0, 'download local file');
+is($body, $payload, 'scalar output preserves binary data');
+is($curl->getinfo(CURLINFO_SIZE_DOWNLOAD), length($payload), 'download size');
+
+SKIP: {
