   SPAGAIN;
+  /* Discard every result, including the LCD and the single-match case.
+   * A later callback must not see mortal values freed by FREETMPS. */
+  sp -= count;
 
   if (only_lcd) {
     if (count == 0) {           /* no match */
@@ -1526,8 +1529,8 @@
