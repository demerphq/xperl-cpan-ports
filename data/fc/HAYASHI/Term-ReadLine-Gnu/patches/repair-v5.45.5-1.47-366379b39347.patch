--- a/t/readline.t
+++ b/t/readline.t
@@ -11,7 +11,7 @@
 
 use strict;
 use warnings;
-use Test::More tests => 152;
+use Test::More tests => 162;
 use Data::Dumper;
 
 # redefine Test::Mode::note due to it requires Perl 5.10.1.
@@ -789,6 +789,32 @@
 $INSTR = "t/co\cIRE\cI\cM";
 $line = $t->readline("ignore_some_completion>");
 ok($line eq 't/comptest/README ', "ingore_some_completion\t[$line]");
+
+# Read another key after each filter call to exercise callback stack cleanup.
+for my $case (
+    ['single match', 't/comptest/023456', sub { @_ },
+     't/comptest/023456 ', 1],
+    ['reject single match', 't/comptest/023456', sub { () },
+     't/comptest/023456', 1],
+    ['reject all matches', 't/comptest/0', sub { () },
+     't/comptest/0', 4],
+    ['return only LCD', 't/comptest/0', sub { $_[0] },
+     't/comptest/0', 4],
+    ['undef in matches', 't/comptest/0',
+     sub { ($_[0], undef, grep { /0123$/ } @_[1 .. $#_]) },
+     't/comptest/0123 ', 4],
+) {
+    my ($name, $text, $filter, $expected, $argc) = @$case;
+    my @args;
+    $a->{ignore_some_completions_function} = sub {
+        @args = @_;
+        return $filter->(@_);
+    };
+    $INSTR = "$text\cI\cM";
+    $line = $t->readline("completion filter $name>");
+    is($line, $expected, "completion filter: $name");
+    is(scalar @args, $argc, "completion filter arguments: $name");
+}
 undef $a->{ignore_some_completions_function};
 
