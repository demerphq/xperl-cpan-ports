--- a/t/34-hook-errors.t
+++ b/t/34-hook-errors.t
@@ -0,0 +1,54 @@
+#!perl
+
+use strict;
+use warnings;
+
+use Scalar::Util qw(refaddr);
+use Test::More;
+
+BEGIN { delete $ENV{PERL_INDIRECT_PM_DISABLE} }
+
+# A hook that dies during compilation reports its error after the
+# compilation errors found before it, without hiding them.
+
+our @hook_diagnostics;
+
+my $code = <<'CODE';
+#line 1 "virtual"
+use strict;
+no indirect hook => sub {
+ eval { die "hook says no\n" };
+ @main::hook_diagnostics = ref $@ && $@->can('contents')
+                         ? @{$@->contents} : ();
+ die $@;
+};
+sub foo { $bar }
+sub never { baz $_ }
+1;
+CODE
+
+is eval $code, undef, 'code with a compilation error and a dying hook fails';
+my $error = $@;
+my $core_err = qr/Global symbol "\$bar" requires explicit package name\b[^\n]* at virtual line 8\.\n/;
+
+if (defined ${^XPERL_VERSION}) {
+ isa_ok $error, 'XPerl::Exception';
+ my @diagnostics = @{$error->contents};
+ is_deeply [ map { $_->code } @diagnostics ],
+           [ 'ERROR_STRICT_VARS_GLOBAL_SYMBOL_REQUIRES_EXPLICIT_PACKAGE_NAME',
+             'ERROR_USER_TEXT' ],
+           'compilation error first, then the hook error';
+ is_deeply [ @{$diagnostics[0]->location}{qw(file line)} ], [ 'virtual', 8 ],
+           'compilation error keeps its source location';
+ ok scalar(grep { my $seen = $_;
+                  grep { refaddr($_) == refaddr($seen) } @hook_diagnostics }
+            $diagnostics[1]),
+    'the hook error is the diagnostic the hook raised';
+ like "$error", qr/\A$core_err\Qhook says no\E\n/,
+      'rendered errors are in diagnostic order';
+} else {
+ like $error, qr/\A$core_err\Qhook says no\E\n/,
+      'compilation error first, then the hook error';
+}
+
+done_testing;
