--- a/indirect.xs
+++ b/indirect.xs
@@ -168,7 +168,47 @@
 #endif
 
 /* ... Safe version of call_sv() ........................................... */
+
+#ifdef XPERL_VERSION
+
+/* XPerl keeps compile errors in a pending structured exception rather than
+ * in ERRSV and PL_errors, so call_sv's eval cannot clobber them. ERRSV is
+ * only saved so that a successful hook leaves it as it was. A failing hook's
+ * exception is appended to the pending errors by croak_sv, which delivers
+ * the whole aggregate with each diagnostic's identity and order intact. */
+static I32 indirect_call_sv(pTHX_ SV *sv, I32 flags) {
+#define indirect_call_sv(S, F) indirect_call_sv(aTHX_ (S), (F))
+ I32          ret, cxix;
+ PERL_CONTEXT saved_cx;
+ SV          *saved_errsv = NULL;
+
+ if (SvTRUE(ERRSV)) {
+  saved_errsv = sv_2mortal(newSVsv(ERRSV));
+  CLEAR_ERRSV();
+ }
+
+ cxix     = (cxstack_ix < cxstack_max) ? (cxstack_ix + 1) : Perl_cxinc(aTHX);
+ /* The last popped context will be reused by call_sv(), but our callers may
+  * still need its previous value. Back it up so that it isn't clobbered. */
+ saved_cx = cxstack[cxix];
+
+ ret = call_sv(sv, flags | G_EVAL);
+
+ cxstack[cxix] = saved_cx;
+
+ if (SvTRUE(ERRSV)) {
+  SV *err = sv_2mortal(newSVsv(ERRSV));
+  CLEAR_ERRSV();
+  croak_sv(err);
+ } else if (saved_errsv) {
+  sv_setsv(ERRSV, saved_errsv);
+ }
 
+ return ret;
+}
+
+#else /* !XPERL_VERSION */
+
 static I32 indirect_call_sv(pTHX_ SV *sv, I32 flags) {
 #define indirect_call_sv(S, F) indirect_call_sv(aTHX_ (S), (F))
  I32          ret, cxix;
@@ -228,6 +268,8 @@
 
  return ret;
 }
+
+#endif /* XPERL_VERSION */
 
