@@ -0,0 +1,87 @@
+# please insert nothing before this line: -*- mode: cperl; cperl-indent-level: 4; indent-tabs-mode: nil -*-
+package TestDirective::callback_stack;
+
+use strict;
+use warnings FATAL => 'all';
+
+use Apache::Test;
+use Apache::TestUtil;
+use Apache2::CmdParms ();
+use Apache2::Module ();
+use Apache2::RequestRec ();
+use APR::Table ();
+use Apache2::Const -compile => 'OK';
+
+{
+    package TestDirective::callback_stack::Command;
+    sub name         { 'CallbackStackValue' }
+    sub func         { 'set_value' }
+    sub args_how     { 'TAKE1' }
+    sub req_override { 'OR_ALL' }
+    sub errmsg       { 'callback stack test value' }
+    sub cmd_data     { 'stack' }
+}
+
+# Metadata methods, constructors and directive handlers all borrow objects
+# from their caller. Repeated calls must preserve those objects.
+my @directives = (bless {}, __PACKAGE__ . '::Command');
+Apache2::Module::add(__PACKAGE__, \@directives);
+
+sub DIR_CREATE    { bless { values => [] }, shift }
+sub SERVER_CREATE { DIR_CREATE(@_) }
+
+sub set_value {
+    my ($self, $parms, $value) = @_;
+    die 'lost command parameters' unless $parms->info eq 'stack';
+    push @{ $self->{values} }, $value;
+    return;
+}
+
+sub DIR_MERGE {
+    my ($base, $add) = @_;
+    return bless { values => [@{ $base->{values} }, @{ $add->{values} }] },
+        ref $base;
+}
+sub SERVER_MERGE { DIR_MERGE(@_) }
+
+our $section_calls = 0;
+sub section {
+    my ($parms, $options) = @_;
+    die 'lost callback arguments' unless $parms->server && $options->get('handler');
+    my $dir = Apache2::Module::get_config(__PACKAGE__, $parms->server,
+                                        $parms->context);
+    my $srv = Apache2::Module::get_config(__PACKAGE__, $parms->server);
+    die 'lost configuration objects'
+        unless join(',', @{ $dir->{values} }) eq 'base' && !@{ $srv->{values} };
+    ++$section_calls;
+    return Apache2::Const::OK;
+}
+
+sub handler {
+    my $r = shift;
+    my $dir = Apache2::Module::get_config(__PACKAGE__, $r->server,
+                                        $r->per_dir_config);
+    my $srv = Apache2::Module::get_config(__PACKAGE__, $r->server);
+    plan $r, tests => 3;
+    ok t_cmp($dir->{values}, [qw(base one two)], 'merged callback results');
+    ok t_cmp($srv->{values}, [], 'server constructor result');
+    ok t_cmp($section_calls, 2, 'repeated callbacks retain their arguments');
+    return Apache2::Const::OK;
+}
+
+1;
+__END__
+
+# APACHE_TEST_CONFIG_ORDER 950
+<Base>
+    PerlLoadModule TestDirective::callback_stack
+    CallbackStackValue base
+    <Perl handler=TestDirective::callback_stack::section>
+        1;
+    </Perl>
+    <Perl handler=TestDirective::callback_stack::section>
+        1;
+    </Perl>
+</Base>
+CallbackStackValue one
+CallbackStackValue two
