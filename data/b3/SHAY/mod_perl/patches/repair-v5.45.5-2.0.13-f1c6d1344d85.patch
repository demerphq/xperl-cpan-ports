+/* Apache callbacks use the traditional, non-RC stack API. Unlike XSUBs,
+ * they can enter Perl without its XS compatibility wrapper. Use a separate
+ * non-RC stack so call_sv() does not free borrowed arguments. Callers need
+ * dSP before PUSH and PUTBACK before POP, with both outside the temp scope.
+ */
+#ifdef PERL_RC_STACK
+#    define MP_PERL_CALLBACK_PUSHSTACK PUSHSTACKi(PERLSI_MAGIC)
+#    define MP_PERL_CALLBACK_POPSTACK POPSTACK
+#else
+#    define MP_PERL_CALLBACK_PUSHSTACK NOOP
+#    define MP_PERL_CALLBACK_POPSTACK NOOP
+#endif
+
