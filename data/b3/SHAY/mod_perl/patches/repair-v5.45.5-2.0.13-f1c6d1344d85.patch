+++ b/Apache-Test/t/serverroot.t
@@ -0,0 +1,66 @@
+use strict;
+use warnings FATAL => 'all';
+
+use Test::More tests => 7;
+use File::Temp qw(tempdir);
+use File::Spec::Functions qw(catfile rel2abs);
+use Apache::TestConfig ();
+
+{
+    package TestServerRootConfig;
+    use vars qw(@ISA);
+    @ISA = qw(Apache::TestConfig);
+
+    sub apxs {
+        my ($self, $query) = @_;
+        return $self->{queries}->{$query};
+    }
+}
+
+my $dir = rel2abs(tempdir('serverroot-XXXXXX', DIR => '.', CLEANUP => 1));
+for my $name (qw(conf prefix root base)) {
+    mkdir catfile($dir, $name), 0700 or die "mkdir $name: $!";
+}
+
+my $conf = catfile($dir, 'conf');
+mkdir catfile($conf, 'modules'), 0700 or die "mkdir modules: $!";
+my $config = bless {
+    queries => {PREFIX => '', SYSCONFDIR => $conf},
+    inherit_config => {ServerRoot => '', LoadModule => []},
+}, 'TestServerRootConfig';
+
+is($config->server_file_rel2abs('modules/*.load'),
+   catfile($conf, 'modules', '*.load'), 'empty PREFIX uses SYSCONFDIR');
+
+my $prefix = $config->{queries}->{PREFIX} = catfile($dir, 'prefix');
+is($config->server_file_rel2abs('module.load'),
+   catfile($prefix, 'module.load'), 'PREFIX precedes SYSCONFDIR');
+
+my $root = $config->{inherit_config}->{ServerRoot} = catfile($dir, 'root');
+is($config->server_file_rel2abs('module.load'),
+   catfile($root, 'module.load'), 'inherited ServerRoot precedes PREFIX');
+
+my $base = catfile($dir, 'base');
+is($config->server_file_rel2abs('module.load', $base),
+   catfile($base, 'module.load'), 'explicit base precedes ServerRoot');
+is($config->server_file_rel2abs(catfile($conf, 'module.load')),
+   catfile($conf, 'module.load'), 'absolute path is preserved');
+
+delete $config->{queries}->{SYSCONFDIR};
+is($config->server_file_rel2abs('module.load'),
+   catfile($root, 'module.load'), 'SYSCONFDIR is optional');
+
+$config->{queries} = {PREFIX => '', SYSCONFDIR => $conf};
+$config->{inherit_config}->{ServerRoot} = '';
+my $main = catfile($conf, 'apache2.conf');
+my $load = catfile($conf, 'mpm.load');
+open my $fh, '>', $main or die "open $main: $!";
+print $fh "Include mpm.load\n";
+close $fh or die "close $main: $!";
+open $fh, '>', $load or die "open $load: $!";
+print $fh "LoadModule mpm_event_module modules/mod_mpm_event.so\n";
+close $fh or die "close $load: $!";
+$config->inherit_config_file_or_directory($main);
+is_deeply($config->{inherit_config}->{LoadModule},
+          [['mpm_event_module', 'modules/mod_mpm_event.so']],
+          'relative include inherits the MPM without ServerRoot or PREFIX');
