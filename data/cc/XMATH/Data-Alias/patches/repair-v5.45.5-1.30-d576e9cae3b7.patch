+# Return values must survive unwinding the loop and its lexical variables.
+sub nested_alias_return {
+	for (1, 2) {
+		my $value = 42;
+		alias return $value, $value;
+	}
+}
+my @local_refs = \nested_alias_return();
+is scalar nested_alias_return(), 42, 'scalar return through a loop';
+is $local_refs[0], $local_refs[1], 'list return preserves alias identity';
+is_deeply [map $$_, @local_refs], [42, 42], 'returned lexicals survive';
+${$local_refs[0]} = 99;
