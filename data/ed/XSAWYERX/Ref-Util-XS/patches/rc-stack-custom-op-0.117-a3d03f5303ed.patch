--- /dev/null
+++ b/t/ownership.t
@@ -0,0 +1,43 @@
+use strict;
+use warnings;
+use Test::More;
+use Scalar::Util qw(weaken);
+use Ref::Util::XS qw(is_arrayref is_hashref);
+
+my @warnings;
+local $SIG{__WARN__} = sub { push @warnings, @_ };
+
+# Direct calls use custom ops when supported. Calls through a code reference
+# use an ordinary XSUB; both paths must release the consumed argument.
+my $dynamic = \&is_hashref;
+my @probes = (
+    [sub { scalar is_hashref($_[0]) }, 'scalar custom op'],
+    [sub { my @values = ('before', is_hashref($_[0]), 'after');
+           is_deeply(\@values, ['before', 1, 'after'], 'adjacent stack values');
+         }, 'list custom op'],
+    [sub { is_hashref($_[0]); return }, 'void custom op'],
+    [sub { scalar $dynamic->($_[0]) }, 'dynamic XSUB'],
+);
+for my $probe (@probes) {
+    my ($run, $label) = @$probe;
+    my $weak;
+    {
+        my $value = {};
+        $weak = $value;
+        weaken($weak);
+        $run->($value);
+    }
+    ok(!defined($weak), "$label releases its input");
+}
+
+my $weak_array;
+{
+    my $array = [];
+    $weak_array = $array;
+    weaken($weak_array);
+    ok(is_arrayref($array), 'array custom op returns true');
+}
+ok(!defined($weak_array), 'array custom op releases its input');
+is_deeply(\@warnings, [], 'predicates balance ownership without warnings');
+
+done_testing();
