+{
+    # Keep the members alive until the union acquires strong references.
+    # PERL_RC_STACK can release anonymous arguments before the union runs.
+    my ($left, $right) = (["ø"], ["þ"]);
+    $set = Set::Object::weak_set($left) + Set::Object::weak_set($right);
+    is($set->size(), 2, "computations on sets don't care that they're weak");
+    ok(!$set->is_weak, "the union of weak sets is strong");
