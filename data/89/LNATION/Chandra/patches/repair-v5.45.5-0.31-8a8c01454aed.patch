--- /dev/null
+++ b/t/69_hash_lifetimes.t
@@ -0,0 +1,88 @@
+use strict;
+use warnings;
+use Test::More;
+use File::Temp qw(tempdir);
+use Chandra::App;
+use Chandra::Socket::Hub;
+
+{
+    package Chandra::Test::HashWebview;
+    sub init { }
+    sub bind { }
+    sub loop { 1 }
+    sub exit { $_[0]{exited}++ }
+    sub eval_js { push @{ $_[0]{scripts} }, $_[1] }
+}
+
+for my $method (qw(refresh run)) {
+    my $app = Chandra::App->new;
+    my $wv = bless { scripts => [] }, 'Chandra::Test::HashWebview';
+    $app->{_webview} = $wv;
+    my $calls = 0;
+    $app->route('/', sub {
+        # Force hash growth while XS is waiting for the route callback.
+        $app->{"extra_$_"} = $_ for 1 .. 128;
+        $calls++;
+        return '<p>grown</p>';
+    });
+    $app->{_current_route} = '/';
+    my @warnings;
+    {
+        local $SIG{__WARN__} = sub { push @warnings, @_ };
+        $app->$method;
+    }
+    is_deeply(\@warnings, [], "$method leaves no reference-count warnings");
+    is($calls, 1, "$method calls the existing current route");
+    ok(grep(/document\.write.*grown/, @{ $wv->{scripts} }),
+        "$method uses the webview after the app hash grows");
+    is($app->{_current_route}, '/', "$method preserves the current route");
+    is($wv->{exited}, 1, 'run exits the webview') if $method eq 'run';
+}
+
+{
+    my $app = Chandra::App->new;
+    my $callback = sub { 'original' };
+    $app->on_tick($callback);
+    $app->on_tick(sub { 'replacement' });
+    is($callback->(), 'original', 'replacing a tick callback preserves caller ownership');
+    is($app->{_tick_cb}->(), 'replacement', 'replacement callback is stored');
+}
+
+{
+    require Chandra::ContextMenu;
+    my $action = sub { 'action survived' };
+    my $items = [ { label => 'action', action => $action } ];
+    my $menu = Chandra::ContextMenu->new(items => $items);
+    $menu->attach('hash-test');
+    is($menu->{_actions}{ $items->[0]{_id} }, $action,
+        'context menu keeps the action when adding its id grows the item hash');
+}
+
+SKIP: {
+    skip 'Unix listener setup requires Unix sockets', 3 if $^O eq 'MSWin32';
+    require Socket;
+    require IO::Socket::UNIX;
+    socketpair(my $socket, my $peer, Socket::AF_UNIX(),
+        Socket::SOCK_STREAM(), 0)
+        or skip "socketpair unavailable: $!", 3;
+    bless $socket, 'IO::Socket::UNIX';
+
+    my $dir = tempdir(CLEANUP => 1);
+    local $ENV{XDG_RUNTIME_DIR} = $dir;
+    local $ENV{TMPDIR} = $dir;
+    no warnings qw(redefine once);
+    # Exercise listener setup without a display or a listening socket.
+    local *IO::Socket::UNIX::new = sub { $socket };
+    my $hub = Chandra::Socket::Hub->new(name => 'hash-lifetimes');
+    open my $fh, '<', $hub->{_token_path} or die "open token: $!";
+    my $token = do { local $/; <$fh> };
+    close $fh;
+    chomp $token;
+    is($token, $hub->token, 'listener setup writes the hub token');
+    is($hub->{_select}->count, 1, 'listener is registered after hash growth');
+    $hub->close;
+    ok(!-e $hub->{_token_path}, 'close removes the token file');
+    close $peer;
+}
+
+done_testing;
