+#  define FAA_PUSHs(sv)  (assert(rpp_stack_is_rc()), *++sp = SvREFCNT_inc(sv))
+#  define FAA_mPUSHs(sv) (assert(rpp_stack_is_rc()), *++sp = (sv))
+#  define FAA_POPs      (assert(rpp_stack_is_rc()), sv_2mortal(*sp--))
+#else
+#  define FAA_PUSHs(sv)  PUSHs(sv)
+#  define FAA_mPUSHs(sv) mPUSHs(sv)
+#  define FAA_POPs      POPs
+#endif
