--- a/t/31destroy.t
+++ b/t/31destroy.t
@@ -5,7 +5,7 @@
 
 use Test2::V0 0.000148; # is_oneref
 
-use Scalar::Util qw( reftype );
+use Scalar::Util qw( reftype weaken );
 
 use Future;
 
@@ -57,4 +57,45 @@
    undef $generated_cv;
 }
 
+# A value held only by the expression stack survives suspension and resume.
+{
+   my $weak;
+   my $pending = Future->new;
+   my $result = (async sub {
+      return [ (sub {
+         my $value = bless [], "StackValue";
+         $weak = $value;
+         weaken($weak);
+         return $value;
+      })->(), await $pending ];
+   })->();
+
+   ok( defined $weak, 'expression stack value survives suspension' );
+   $pending->done("ready");
+   is( $result->get->[1], "ready", 'expression completes after resume' );
+   ok( defined $weak, 'returned result keeps expression stack value alive' );
+   undef $result;
+   ok( !defined $weak, 'expression stack value freed after result is dropped' );
+}
+
+# Cancelling a suspended frame releases values held only by its stack.
+{
+   my $weak;
+   my $pending = Future->new;
+   my $result = (async sub {
+      return [ (sub {
+         my $value = bless [], "StackValue";
+         $weak = $value;
+         weaken($weak);
+         return $value;
+      })->(), await $pending ];
+   })->();
+
+   ok( defined $weak, 'expression stack value survives until cancellation' );
+   $result->cancel;
+   undef $result;
+   undef $pending;
+   ok( !defined $weak, 'cancelled expression stack value is freed' );
+}
+
 done_testing;
