--- a/t/01-io.t
+++ b/t/01-io.t
@@ -9,6 +9,34 @@
 
 is_deeply [from_javabin()], [], 'from_javabin no args, array context';
 
+is_deeply [ 'before', from_javabin(), 'after' ], [ 'before', 'after' ],
+    'empty decode preserves surrounding list values';
+
+my @encoded = to_javabin('perl');
+is_deeply \@encoded, [ "\2\x24perl" ], 'encode returns one list value';
+
+my @decoded = from_javabin("\2\x24perl");
+is_deeply \@decoded, [ 'perl' ], 'decode returns one list value';
+
+is_deeply [ 'before', to_javabin('perl'), 'after' ],
+    [ 'before', "\2\x24perl", 'after' ],
+    'encode preserves surrounding list values';
+
+is_deeply [ 'before', from_javabin("\2\x24perl"), 'after' ],
+    [ 'before', 'perl', 'after' ],
+    'decode preserves surrounding list values';
+
+is_deeply [ map { to_javabin($_) } qw/first second/ ],
+    [ "\2\x25first", "\2\x26second" ],
+    'repeated encoding returns independent values';
+
+is to_javabin(), "\2\0", 'encode with no arguments produces null';
+
+to_javabin('discarded');
+from_javabin("\2\x24perl");
+is from_javabin(to_javabin('retained')), 'retained',
+    'calls in void context preserve the next call';
+
 my %from = (
      'expected version 2' => "\0\0",
     'insufficient length' => '',
