 my $loaded = 1;
 END {print "not ok 1\n" unless $loaded;}
 
+# Cached getters need no socket or permission to change an interface.
+# Exercise the name copies even when interface discovery is unavailable.
+foreach my $name ('', 'lo', 'x' x 15, 'x' x 4096) {
+    my $if = bless {
+	name => $name,
+	flav => 1,
+	args => { mtui => 1500, metk => 0, flag => 1.0, indx => 1 },
+    }, 'Net::Interface';
+    foreach my $check ([mtu => 1500], [metric => 0],
+		      [flags => 1], [index => 1]) {
+	my ($method, $expected) = @$check;
+	is($if->$method(), $expected,
+	    "$method with cached name length " . length($name));
+    }
+    eval { $if->new(); };
+    is($@, '', 'refresh handles cached name length ' . length($name));
+}
+
 my @all = Net::Interface->interfaces();
 
