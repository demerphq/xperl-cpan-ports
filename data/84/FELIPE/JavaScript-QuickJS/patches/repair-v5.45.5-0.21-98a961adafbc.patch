--- a/t/promise.t
+++ b/t/promise.t
@@ -55,4 +55,40 @@
     ],
 );
 
+for my $rejected (0, 1) {
+    for my $arity (0 .. 2) {
+        my @calls;
+        my $promise = $js->eval(
+            $rejected
+                ? 'Promise.resolve().then(() => { throw 123; })'
+                : 'Promise.resolve(123)',
+        );
+        my @callbacks = (
+            sub { push @calls, ['success', @_]; return 234 },
+            sub { push @calls, ['failure', @_]; return 345 },
+        );
+        splice @callbacks, $arity;
+
+        my $next = $promise->then(@callbacks);
+        $next->then(
+            sub { push @calls, ['resolved', @_]; return },
+            sub { push @calls, ['rejected', @_]; return },
+        );
+        $js->await();
+
+        my $expected = $rejected
+            ? ($arity == 2
+                ? [['failure', 123], ['resolved', 345]]
+                : [['rejected', 123]])
+            : ($arity
+                ? [['success', 123], ['resolved', 234]]
+                : [['resolved', 123]]);
+
+        cmp_deeply(
+            \@calls, $expected,
+            ($rejected ? 'rejected' : 'resolved') . " promise, $arity callbacks",
+        );
+    }
+}
+
 done_testing;
