@@ -117,4 +117,26 @@
 is(FA::set_typed_var($holes2, 9), 9, 'by the typed setter too');
 is($holes2->typed, 9, 'and read');
 
+my $payload = ['retained'];
+my $weak_payload = $payload;
+weaken($weak_payload);
+my $owner = FA->new(req => 1, plain => $payload);
+undef $payload;
+my $held = FA::get_plain($owner);
+undef $owner;
+is_deeply($held, ['retained'], 'a custom getter result outlives its object');
+undef $held;
+ok(!defined $weak_payload, 'the getter leaves no extra reference to its result');
+
+$owner = FA->new(req => 1);
+$payload = ['assigned'];
+$weak_payload = $payload;
+weaken($weak_payload);
+$held = FA::set_plain($owner, $payload);
+undef $payload;
+undef $owner;
+is_deeply($held, ['assigned'], 'a custom setter result outlives its arguments');
+undef $held;
+ok(!defined $weak_payload, 'the setter leaves no extra reference to its result');
+
 done_testing;
--- a/t/066-modifier-and-destroy-edges.t
+++ b/t/066-modifier-and-destroy-edges.t
@@ -66,4 +66,28 @@
 ok(MD::Elsewhere->can('md_a'), 'import_accessor takes the package as its fourth argument');
 is(MD::Elsewhere::md_a($o), undef, 'and the accessor works there');
 
+package MDResults;
+sub values { return wantarray ? ([1], [2]) : [3] }
+sub wrapped_values { return wantarray ? ([4], [5]) : [6] }
+package main;
+
+Object::Proto::define('MDResults', 'a');
+Object::Proto::around('MDResults::wrapped_values', sub {
+    my $orig = shift;
+    return $orig->(@_);
+});
+my @after;
+for my $method (qw(values wrapped_values)) {
+    Object::Proto::after("MDResults::$method", sub {
+        push @after, [$_[0], $method];
+    });
+}
+my $results = MDResults->new;
+is_deeply(scalar $results->values, [3], 'a modified scalar result survives the after callback');
+is_deeply([$results->values], [[1], [2]], 'modified list results survive the after callback');
+is_deeply(scalar $results->wrapped_values, [6], 'an around scalar result survives the after callback');
+is_deeply([$results->wrapped_values], [[4], [5]], 'around list results survive the after callback');
+is_deeply(\@after, [map { [$results, $_] } qw(values values wrapped_values wrapped_values)],
+    'after callbacks retain their arguments when results have been popped');
+
 done_testing;
