@@ -14,6 +14,16 @@
 /* Include shared XOP compatibility for custom ops (5.14+ fallback) */
 #include "xop_compat.h"
 
+/* Custom ops use the traditional stack API. The wrapper accounts for
+ * argument and result ownership on reference-counted stacks. */
+#if defined(XPERL_VERSION) || defined(XSPP_wrapped)
+#  define OBJECT_PP(name, nargs) \
+    static OP *name(pTHX); \
+    XSPP_wrapped(name, nargs, 0)
+#else
+#  define OBJECT_PP(name, nargs) static OP *name(pTHX)
+#endif
+
 /* Linkage for the C API in object_types.h, which object.c defines. Not
  * PERL_CALLCONV: Windows Perl defines that as __declspec(dllimport) outside
  * the perl DLL, and MSVC refuses to define a dllimport function (C2491).
