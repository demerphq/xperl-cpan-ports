+# XPerl delivers plain-text die() as an XPerl::Exception, and an explicit
+# rethrow (die $@) adds a "...propagated at FILE line N." context diagnostic.
+# For an exception that is otherwise a single user-text error, use the text
+# ordinary Perl would have produced, so client messages carry no server
+# paths. Anything else keeps its full rendering.
+sub _message_text {
+  my ($item) = @_;
+  if (Scalar::Util::blessed($item) && $item->isa('XPerl::Exception')) {
+    my @roots = grep $_->code ne 'ERROR_PROPAGATION_RETHROW_CONTEXT',
+      @{ $item->contents };
+    if (@roots == 1 && $roots[0]->code eq 'ERROR_USER_TEXT') {
+      my ($text) = map $_->{value}, grep $_->{name} eq 'text',
+        @{ $roots[0]->params || [] };
+      return $text =~ /\n\z/ ? $text : $roots[0]->render . "\n"
+        if defined $text;
+    }
+  }
+  $item.'';
+}
