--- a/t/90_regression/leolo-sig-die.t
+++ b/t/90_regression/leolo-sig-die.t
@@ -96,4 +96,12 @@
 eval { $poe_kernel->run };
 
 # make sure we caught the execption thrown in array_ctx3
-is($@, "array_ctx3\nmore\n", 'exited when expected');
+if (${^XPERL_VERSION}) {
+  my $error = $@;
+  require XPerl::DiagGroup;
+  ok($error->has_diagnostic('ERROR_USER_TEXT', text => "array_ctx3\nmore\n"),
+    'exited when expected');
+}
+else {
+  is($@, "array_ctx3\nmore\n", 'exited when expected');
+}
--- a/t/90_regression/rt19908-merlyn-stop.t
+++ b/t/90_regression/rt19908-merlyn-stop.t
@@ -34,5 +34,13 @@
 
 eval { POE::Kernel->run() };
 $SIG{ALRM} = "IGNORE";
-ok($@ eq "stop\n", "stopped due to a 'stop' exception (in _stop)");
+if (${^XPERL_VERSION}) {
+  my $error = $@;
+  require XPerl::DiagGroup;
+  ok($error->has_diagnostic('ERROR_USER_TEXT', text => "stop\n"),
+    "stopped due to a 'stop' exception (in _stop)");
+}
+else {
+  ok($@ eq "stop\n", "stopped due to a 'stop' exception (in _stop)");
+}
 ok($stop_count == 1, "stopped after one _stop");
