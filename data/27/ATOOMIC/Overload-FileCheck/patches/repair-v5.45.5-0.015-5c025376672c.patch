--- a/t/stack-corruption.t
+++ b/t/stack-corruption.t
@@ -61,6 +61,61 @@
 
 is $TOTAL_CALL, 3, "mystat was called 3 times";
 
+unmock_all_file_checks();
+
+subtest 'callback and opcode stack ownership' => sub {
+    my @files;
+    mock_file_check( e => sub {
+        push @files, $_[0];
+        die "callback stopped\n" if $_[0] eq 'die';
+        return CHECK_IS_TRUE;
+    } );
+
+    is [ 'before', -e join('', '/temporary/', 'file'), 'after' ],
+      [ 'before', 1, 'after' ], 'temporary operand preserves surrounding values';
+    is [ 'before', -e _, 'after' ], [ 'before', 1, 'after' ],
+      'underscore has no stack operand';
+    is \@files, [ '/temporary/file', '/temporary/file' ],
+      'underscore callback receives the preceding filename';
+
+    eval { my $result = -e 'die' };
+    like $@, qr/callback stopped/, 'callback exception unwinds the stack';
+    ok -e join('', '/after/', 'exception'), 'callback works after exception';
+    unmock_all_file_checks();
+
+    mock_file_check( s => sub { return join('', '12', '34') } );
+    is [ 'before', -s join('', '/size/', 'file'), 'after' ],
+      [ 'before', 1234, 'after' ], 'integer callback result stays alive';
+    unmock_all_file_checks();
+
+    for my $check (qw(M A C)) {
+        mock_file_check( $check => sub { my $age = -1.25; return \$age } );
+        my $age = eval "-$check '/age/file'";
+        is $@, '', "-$check callback succeeds";
+        is $age, -1.25, "-$check preserves the NV result";
+        unmock_all_file_checks();
+    }
+
+    my @real_stat = stat($0);
+    mock_file_check( e => sub { FALLBACK_TO_REAL_OP } );
+    ok -e $0, 'fallback calls the original opcode on the RC stack';
+    unmock_all_file_checks();
+
+    mock_stat( sub { return [@real_stat] } );
+    is [ 'before', stat(join('', '/mock/', 'file')), 'after' ],
+      [ 'before', @real_stat, 'after' ], 'stat callback result stays alive';
+    unmock_all_file_checks();
+
+    mock_stat( sub { return [] } );
+    is [ 'before', scalar stat('/missing'), 'after' ],
+      [ 'before', '', 'after' ], 'failed scalar stat preserves the stack';
+    is [ 'before', scalar lstat('/missing'), 'after' ],
+      [ 'before', '', 'after' ], 'failed scalar lstat preserves the stack';
+    is [ 'before', stat('/missing'), 'after' ], [ 'before', 'after' ],
+      'failed list stat returns no values';
+    unmock_all_file_checks();
+};
+
 done_testing;
 
