+++ b/t/15glyph_fallback.t
@@ -0,0 +1,40 @@
+use strict;
+use warnings;
+use Test::More;
+use File::Spec::Functions;
+use Font::FreeType;
+
+my $face = Font::FreeType->new->face(catfile(qw(t data Vera.ttf)));
+my $missing = "\x{10FFFF}";
+
+is($face->glyph_from_char_code(ord $missing), undef,
+   'test character is absent from the font');
+
+my $glyph = $face->glyph_from_char('A');
+isa_ok($glyph, 'Font::FreeType::Glyph');
+is($glyph->index, $face->glyph_from_char_code(ord 'A')->index,
+   'omitted fallback finds an existing glyph');
+
+is($face->glyph_from_char($missing), undef,
+   'omitted fallback returns undef for a missing character');
+is($face->glyph_from_char($missing, 0), undef,
+   'explicit false fallback returns undef for a missing character');
+
+$glyph = $face->glyph_from_char($missing, 1);
+isa_ok($glyph, 'Font::FreeType::Glyph');
+is($glyph->index, 0, 'true fallback returns the missing glyph');
+is($glyph->char_code, ord $missing,
+   'fallback glyph retains the requested character code');
+
+is($face->glyph_from_char($missing), undef,
+   'omitted fallback uses its default after an explicit true argument');
+
+my @glyphs = map { $face->glyph_from_char($_) } ('A', $missing, 'B');
+is_deeply([map { defined $_ ? $_->char_code : undef } @glyphs],
+          [ord('A'), undef, ord('B')],
+          'omitted fallback works inside map');
+
+my @missing = $face->glyph_from_char($missing);
+is_deeply(\@missing, [undef], 'omitted fallback works in list context');
+
+done_testing;
