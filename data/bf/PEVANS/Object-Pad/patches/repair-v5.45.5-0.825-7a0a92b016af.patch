+/* Parser callbacks can run on an RC stack or inside a wrapped XSUB. Give
+ * their Perl calls a private non-RC stack so PUSHs works in either case.
+ */
+#if defined(XPERL_VERSION) && defined(PERL_RC_STACK)
+#  define OBJECTPAD_PUSH_CALLBACK_STACK  PUSHSTACKi(PERLSI_MAGIC)
+#  define OBJECTPAD_POP_CALLBACK_STACK   STMT_START { POPSTACK; SPAGAIN; } STMT_END
+#  define OBJECTPAD_PP(name, nargs)      \
+    static OP *name(pTHX);               \
+    XSPP_wrapped(name, nargs, 0)
+#else
+#  define OBJECTPAD_PUSH_CALLBACK_STACK  NOOP
+#  define OBJECTPAD_POP_CALLBACK_STACK   NOOP
+#  define OBJECTPAD_PP(name, nargs)      static OP *name(pTHX)
+#endif
+
 #define HAVE_PERL_VERSION(R, V, S) \
     (PERL_REVISION > (R) || (PERL_REVISION == (R) && (PERL_VERSION > (V) || (PERL_VERSION == (V) && (PERL_SUBVERSION >= (S))))))
 
